    -- ═══ Auto Upgrade Recycler (dropdown Upgrades, y=82) ═══════════════
    -- Guna module ASAL game terus (confirmed dari dump
    -- RecyclerController/RecyclerView/RecyclerLevels) — TAK perlu baca
    -- GUI/ProximityPrompt sebab data & action sebenar semua boleh
    -- dipanggil terus:
    --   - Level, Tower best, Rebirth count, Money: DataService.client:get(...)
    --     + DataController.money() — SAMA data yg RecyclerController.recyclerView()
    --     guna dalaman (tak perlu UI dibuka / GetChildren() index yg boleh berubah).
    --   - Requirement floor & cost: RecyclerView.gateFloor(level) /
    --     RecyclerView.upgradeCost(level) — formula & table ASAL game
    --     (RecyclerLevels), bukan kira/teka sendiri.
    --   - Action upgrade: ReplicatedStorage.Remotes.UpgradeRecycler:InvokeServer()
    --     — confirmed dari RecyclerController.upgrade(). LEBIH RELIABLE
    --     drpd fireproximityprompt sebab tak bergantung ProximityPrompt
    --     instance/UI 3D dimount dalam jarak — remote terus, macam
    --     Rebirth/RequestCheckpointTp dll yg dah confirmed berkesan.
    local ReplicatedStorage_ur = game:GetService("ReplicatedStorage")
    local DataService_ur = nil
    local RecyclerView_ur = nil
    local DataController_ur = nil
    local UpgradeRecyclerRemote_ur = nil

    local function ensureRecyclerModules()
        if not DataService_ur then
            local ok, mod = pcall(function()
                return require(ReplicatedStorage_ur.Packages.DataService).client
            end)
            if ok then DataService_ur = mod end
        end
        if not RecyclerView_ur then
            local ok, mod = pcall(function()
                return require(ReplicatedStorage_ur.Features.Scrap.RecyclerView)
            end)
            if ok then RecyclerView_ur = mod end
        end
        if not DataController_ur then
            local ok, mod = pcall(function()
                return require(V.LocalPlayer:WaitForChild("PlayerScripts").Core.Data.DataController)
            end)
            if ok then DataController_ur = mod end
        end
        if not UpgradeRecyclerRemote_ur then
            local ok, remote = pcall(function()
                return ReplicatedStorage_ur:WaitForChild("Remotes", 5):WaitForChild("UpgradeRecycler", 5)
            end)
            if ok then UpgradeRecyclerRemote_ur = remote end
        end
        return DataService_ur and RecyclerView_ur and DataController_ur and UpgradeRecyclerRemote_ur
    end

    local function getRecyclerSnapshot()
        local scrapData = DataService_ur:get({"scrap"})
        local level = (scrapData and scrapData.recyclerLevel) or 0

        local towerData = DataService_ur:get({"tower"})
        local towerBest = (towerData and towerData.best) or 0

        local rebirthData = DataService_ur:get({"rebirth"})
        local rebirthCount
        if type(rebirthData) == "table" then
            rebirthCount = rebirthData.count or 0
        elseif type(rebirthData) == "number" then
            rebirthCount = rebirthData
        else
            rebirthCount = 0
        end

        local moneyOk, money = pcall(function()
            return DataController_ur.money():toNumber()
        end)
        if not moneyOk then money = 0 end

        return {
            level        = level,
            towerBest    = towerBest,
            rebirthCount = rebirthCount,
            money        = money,
            upgradeCost  = RecyclerView_ur.upgradeCost(level),
            canUpgrade   = RecyclerView_ur.canUpgrade(level, rebirthCount),
            floorReq     = RecyclerView_ur.gateFloor(level),
            floorLocked  = not RecyclerView_ur.floorUnlocked(level, towerBest),
            busy         = V.LocalPlayer:GetAttribute(RecyclerView_ur.BusyAttr) == true,
            locked       = V.LocalPlayer:GetAttribute(RecyclerView_ur.LockedAttr) == true,
        }
    end

    V.autoUpgradeRecyclerEnabled_af = false
