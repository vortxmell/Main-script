    local function autoUpgradeRecyclerRunLoop()
        if autoUpgradeRecyclerLoopRunning then return end
        autoUpgradeRecyclerLoopRunning = true
        task.spawn(function()
            while V.autoUpgradeRecyclerEnabled_af do
                pcall(function()
                    if not ensureRecyclerModules() then return end
                    local snap = getRecyclerSnapshot()
                    if snap.locked or snap.busy then return end
                    if snap.floorLocked then return end       -- tower floor requirement belum cukup
                    if not snap.canUpgrade then return end     -- dah maxLevel(rebirthCount)
                    if snap.money < snap.upgradeCost then return end
                    UpgradeRecyclerRemote_ur:InvokeServer()
                end)
                task.wait(1) -- check tiap 1 saat — requirement naik lepas tiap upgrade berjaya
            end
            autoUpgradeRecyclerLoopRunning = false
        end)
    end

