-- ========================

local function updateLayout()
    local fw = V.MainFrame.AbsoluteSize.X
    local fh = V.MainFrame.AbsoluteSize.Y
    local searchVisible = V.SearchBarContainer and V.SearchBarContainer.Visible

    local tabH    = fh - V.TOP_H
    local bodyY   = V.TOP_H + (searchVisible and V.SEARCH_H or 0)
    local contentH = fh - bodyY
    local rightW  = fw - V.LEFT_W - 2

    V.TopBar.Size = UDim2.new(0, fw, 0, V.TOP_H)
    V.TopBar:FindFirstChild("TopBarFix").Size = UDim2.new(0, fw, 0, math.ceil(V.TOP_H / 2))
    V.TopBar:FindFirstChild("TopDivider").Size = UDim2.new(0, fw, 0, 1)

    if V.SearchBarContainer then
        V.SearchBarContainer.Size = UDim2.new(0, fw - V.LEFT_W - 1, 0, V.SEARCH_H)
        V.SearchBarContainer.Position = UDim2.new(0, V.LEFT_W + 1, 0, V.TOP_H)
    end

    V.LeftPanel.Size     = UDim2.new(0, V.LEFT_W, 0, tabH)
    V.LeftPanel.Position = UDim2.new(0, 0, 0, V.TOP_H)

    V.MainFrame:FindFirstChild("LeftDivider").Size     = UDim2.new(0, 1, 0, tabH)
    V.MainFrame:FindFirstChild("LeftDivider").Position = UDim2.new(0, V.LEFT_W, 0, V.TOP_H)

    V.ContentPanelLeft.Size     = UDim2.new(0, math.floor(rightW / 2), 0, contentH)
    V.ContentPanelLeft.Position = UDim2.new(0, V.LEFT_W + 1, 0, bodyY)

    local midX = V.LEFT_W + 1 + math.floor(rightW / 2)
    V.ContentDivider.Size     = UDim2.new(0, 1, 0, contentH)
    V.ContentDivider.Position = UDim2.new(0, midX, 0, bodyY)

    V.ContentPanelRight.Size     = UDim2.new(0, fw - midX - 1, 0, contentH)
    V.ContentPanelRight.Position = UDim2.new(0, midX + 1, 0, bodyY)

    -- Tab3 (Save Config) full-width panel
    if V.Tab4ContentPanel then
        V.Tab4ContentPanel.Size     = UDim2.new(0, fw - V.LEFT_W - 1, 0, fh - V.TOP_H)
        V.Tab4ContentPanel.Position = UDim2.new(0, V.LEFT_W + 1, 0, V.TOP_H)
    end

    updateScrollState()
end

