                task.delay(0.45, function()
                    updateSpPill(false)
                end)
                return
            end
            startSpectate()
        end
    end)

    -- ── Close popup on outside touch ─────────────────────────────
    V.UserInputService.InputBegan:Connect(function(input)
        if not spPopupOpen then return end
        if input.UserInputType ~= Enum.UserInputType.Touch and
           input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        local tp = input.Position
        local pa = spPopup.AbsolutePosition
        local ps = spPopup.AbsoluteSize
        if tp.X >= pa.X and tp.X <= pa.X + ps.X and
           tp.Y >= pa.Y and tp.Y <= pa.Y + ps.Y then return end
        -- let picker button handle its own toggle
        local ba = spPickerBtn.AbsolutePosition
        local bs = spPickerBtn.AbsoluteSize
        if tp.X >= ba.X and tp.X <= ba.X + bs.X and
           tp.Y >= ba.Y and tp.Y <= ba.Y + bs.Y then return end
        spPopupOpen = false
        spPickerArrow.Text = "▲"
        spPopup.Visible = false
    end)

    -- ── Register with closeAllPopups (minimize closes popup) ─────
    table.insert(V.closeAllPopups, function()
        spPopupOpen = false
        spPickerArrow.Text = "▲"
        spPopup.Visible = false
    end)

    -- cfg: spectate (state only – target player cannot be saved)
    V.cfgRead["sp"] = function()
        return {en=spectEnabled}
    end
    V.cfgApply["sp"] = function(_t)
        -- spectate target must be selected manually; skip toggle restore
    end

end -- end SPECTATE

