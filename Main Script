        end

        -- Kira lateral (kiri/kanan) offset dari center line A→B
        -- "right" vector = forward cross Y-up
        local forward = (ptB - ptA).Unit
        local rightVec = Vector3.new(forward.Z, 0, -forward.X) -- 90° rotate around Y

        local h  = wallH
        local t  = wallT
        local co = wallCorridorOffset

