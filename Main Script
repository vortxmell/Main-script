    --               chicken level Y" dalam Stats Info panel).
    --   canBeat = myLevel >= rivalLevel + 15  (margin 15 level, terus
    --               angka bulat, takde peratus/formula lain).
    local AT3_LEVEL_MARGIN = 15

    -- Reuse atGetMyCoop() (dah wujud atas, dari Auto Tower V1) untuk cari
    -- plot/ChickenBody yg sama — elak duplicate logic pencarian coop.
    local function atv3GetMyLevel()
        local _, plot = atGetMyCoop()
        if not plot then return nil end
        local bodies = workspace:FindFirstChild("ChickenBodies")
        if not bodies then return nil end
        for _, body in ipairs(bodies:GetChildren()) do
            if body.Name:find("coop:" .. tostring(plot), 1, true) then
                local lvlNode = atSafeNavigate(body, "BillboardGui", "Frame", "canvas", "text", "lvl")
                local lvlText = lvlNode and lvlNode:IsA("TextLabel") and lvlNode.Text or nil
                if lvlText then
                    local n = tonumber((lvlText:gsub("%D", "")))
                    if n then return n end
                end
            end
        end
        return nil
    end

    -- Pulangkan: canBeat (bool|nil), myLevel, rivalLevel
    local function atv3CanBeatFloor(mods2, targetFloor)
        local myLevel = atv3GetMyLevel()
        if not myLevel then return nil end

        local ok, flData = pcall(function() return mods2.TowerFloor.at(targetFloor) end)
        if not ok or not flData or not flData.level then return nil end
        local rivalLevel = flData.level

        local canBeat = myLevel >= (rivalLevel + AT3_LEVEL_MARGIN)
        return canBeat, myLevel, rivalLevel
    end

