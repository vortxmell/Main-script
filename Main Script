            local sShifted = ptA + offset
            local eShifted = ptB + offset
            local cf, len = buildWallCF(sShifted, eShifted, h)

            local part = Instance.new("Part")
            part.Size        = Vector3.new(t, h, len)
            part.CFrame      = cf
            part.Anchored    = true
            part.CanCollide  = true
