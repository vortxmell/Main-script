-- SAVE CONFIG (Tab3)
-- File: vort_savecfg_<PlaceId>.json  (per game)
-- Saves all CheatHub toggle / slider / inputbox state + Auto Farm state
-- Excludes: Waypoints (separate file), Spectate target (not serialisable)
-- ========================

do -- === SAVE CONFIG ===

    local cfgFileName = "vort_savecfg_" .. tostring(game.PlaceId) .. ".json"
    local cfgData     = {}    -- { [configName] = stateTable }
    local cfgAutoName = ""    -- config to auto-load on next execute
    local cfgSelName  = ""    -- currently selected config name in list

    -- ── File I/O ──────────────────────────────────────────────────
    local function cfgLoadFile()
        pcall(function()
            if not readfile then return end
            local raw = readfile(cfgFileName)
            if not raw or raw == "" then return end
            local dec = V.HttpService:JSONDecode(raw)
            if type(dec) == "table" then
                cfgData     = type(dec.configs)  == "table"  and dec.configs  or {}
                cfgAutoName = type(dec.autoload) == "string" and dec.autoload or ""
            end
        end)
    end

    local function cfgSaveFile()
        pcall(function()
            if not writefile then return end
            writefile(cfgFileName, V.HttpService:JSONEncode({
                configs  = cfgData,
                autoload = cfgAutoName,
            }))
        end)
    end

    cfgLoadFile()

    -- ── State helpers ─────────────────────────────────────────────
    local function cfgGetState()
        local t = {}
        for k, fn in pairs(V.cfgRead) do
            t[k] = fn()
        end
        return t
    end

    local function cfgSetState(state)
        if type(state) ~= "table" then return end
        for k, fn in pairs(V.cfgApply) do
            if state[k] ~= nil then
                pcall(fn, state[k])
            end
        end
    end

    -- ── Config name inputbox (left) + Save button (right) ─────────
    -- Row y=8, height=22
    local cfgNameBox = Instance.new("TextBox")
    cfgNameBox.Size              = UDim2.new(1, -54, 0, 22)
    cfgNameBox.Position          = UDim2.new(0, 6, 0, 8)
    cfgNameBox.BackgroundColor3  = Color3.fromRGB(20, 20, 20)
    cfgNameBox.BorderSizePixel   = 0
    cfgNameBox.Text              = ""
    cfgNameBox.PlaceholderText   = "Config name..."
    cfgNameBox.TextColor3        = Color3.fromRGB(255, 255, 255)
    cfgNameBox.PlaceholderColor3 = Color3.fromRGB(80, 80, 80)
    cfgNameBox.TextSize          = 10
    cfgNameBox.Font              = Enum.Font.Gotham
    cfgNameBox.TextXAlignment    = Enum.TextXAlignment.Left
    cfgNameBox.ClearTextOnFocus  = false
    cfgNameBox.Parent            = V.Tab4ContentPanel
    do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,4); c.Parent = cfgNameBox end
    do local p = Instance.new("UIPadding"); p.PaddingLeft = UDim.new(0,6); p.Parent = cfgNameBox end

    local cfgSaveBtn = Instance.new("TextButton")
    cfgSaveBtn.Size              = UDim2.new(0, 44, 0, 22)
    cfgSaveBtn.Position          = UDim2.new(1, -50, 0, 8)
    cfgSaveBtn.BackgroundColor3  = Color3.fromRGB(30, 30, 30)
    cfgSaveBtn.BorderSizePixel   = 0
    cfgSaveBtn.Text              = "Save"
    cfgSaveBtn.TextColor3        = Color3.fromRGB(255, 255, 255)
    cfgSaveBtn.TextSize          = 10
    cfgSaveBtn.Font              = Enum.Font.GothamBold
    cfgSaveBtn.Parent            = V.Tab4ContentPanel
    do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,4); c.Parent = cfgSaveBtn end
    do
        local s = Instance.new("UIStroke")
        s.Color = Color3.fromRGB(255, 255, 255)
        s.Thickness = 1
        s.Transparency = 0.7
        s.Parent = cfgSaveBtn
    end

    -- ── Load / Auto Load / Delete row (y=36, height=20) ───────────
    local btnRowFrame = Instance.new("Frame")
    btnRowFrame.Size              = UDim2.new(1, -12, 0, 20)
    btnRowFrame.Position          = UDim2.new(0, 6, 0, 36)
    btnRowFrame.BackgroundTransparency = 1
    btnRowFrame.BorderSizePixel   = 0
    btnRowFrame.Parent            = V.Tab4ContentPanel

    local cfgLoadBtn, cfgAutoLoadBtn, cfgDeleteBtn
    do
        local function mkCfgBtn(txt, ps, po)
            local b = Instance.new("TextButton")
            b.Size              = UDim2.new(1/3, -4, 1, 0)
            b.Position          = UDim2.new(ps, po, 0, 0)
            b.BackgroundColor3  = Color3.fromRGB(30, 30, 30)
            b.BorderSizePixel   = 0
            b.Text              = txt
            b.TextColor3        = Color3.fromRGB(255, 255, 255)
            b.TextSize          = 10
            b.Font              = Enum.Font.Gotham
            b.Parent            = btnRowFrame
            do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,3); c.Parent = b end
            do
                local s = Instance.new("UIStroke")
                s.Color = Color3.fromRGB(255, 255, 255)
                s.Thickness = 1
                s.Transparency = 0.8
                s.Parent = b
            end
            return b
        end
        cfgLoadBtn     = mkCfgBtn("Load",      0,   0)
        cfgAutoLoadBtn = mkCfgBtn("Auto Load", 1/3, 2)
        cfgDeleteBtn   = mkCfgBtn("Delete",    2/3, 4)
    end

    -- ── Thin divider (y=62) ───────────────────────────────────────
    do
        local div = Instance.new("Frame")
        div.Size             = UDim2.new(1, -12, 0, 1)
        div.Position         = UDim2.new(0, 6, 0, 62)
        div.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        div.BackgroundTransparency = 0.85
        div.BorderSizePixel  = 0
        div.Parent           = V.Tab4ContentPanel
    end

    -- ── Scrollable config list (y=66, fills rest of panel) ────────
    local cfgListScroll = Instance.new("ScrollingFrame")
    cfgListScroll.Size               = UDim2.new(1, -12, 1, -68)
    cfgListScroll.Position           = UDim2.new(0, 6, 0, 66)
    cfgListScroll.BackgroundTransparency = 1
    cfgListScroll.BorderSizePixel    = 0
    cfgListScroll.ScrollBarThickness = 4
    cfgListScroll.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 80)
    cfgListScroll.CanvasSize         = UDim2.new(0, 0, 0, 0)
    cfgListScroll.AutomaticCanvasSize = Enum.AutomaticSize.None
    cfgListScroll.ElasticBehavior    = Enum.ElasticBehavior.Never
    cfgListScroll.Parent             = V.Tab4ContentPanel

    -- ── Render config list ────────────────────────────────────────
    local renderCfgList
    renderCfgList = function()
        for _, ch in ipairs(cfgListScroll:GetChildren()) do ch:Destroy() end
        local totalH = 0
        local names = {}
        for k in pairs(cfgData) do table.insert(names, k) end
        table.sort(names)
        for _, nm in ipairs(names) do
            do
                local isSel  = (nm == cfgSelName)
                local isAuto = (nm == cfgAutoName)

                local row = Instance.new("Frame")
                row.Size              = UDim2.new(1, 0, 0, 26)
                row.Position          = UDim2.new(0, 0, 0, totalH)
                row.BackgroundColor3  = Color3.fromRGB(40, 40, 40)
                row.BackgroundTransparency = isSel and 0 or 1
                row.BorderSizePixel   = 0
                row.Parent            = cfgListScroll
                if isSel then
                    do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,3); c.Parent = row end
                end

                local nameLbl = Instance.new("TextLabel")
                nameLbl.Size              = UDim2.new(1, isAuto and -48 or -6, 1, 0)
                nameLbl.Position          = UDim2.new(0, 6, 0, 0)
                nameLbl.BackgroundTransparency = 1
                nameLbl.Text              = nm
                nameLbl.TextColor3        = Color3.fromRGB(255, 255, 255)
                nameLbl.TextSize          = 10
                nameLbl.Font              = isSel and Enum.Font.GothamBold or Enum.Font.Gotham
                nameLbl.TextXAlignment    = Enum.TextXAlignment.Left
                nameLbl.TextTruncate      = Enum.TextTruncate.AtEnd
                nameLbl.Parent            = row

                if isAuto then
                    local autoTag = Instance.new("TextLabel")
                    autoTag.Size              = UDim2.new(0, 38, 0, 16)
                    autoTag.Position          = UDim2.new(1, -42, 0.5, -8)
                    autoTag.BackgroundColor3  = Color3.fromRGB(55, 55, 55)
                    autoTag.BackgroundTransparency = 0
                    autoTag.Text              = "AUTO"
                    autoTag.TextColor3        = Color3.fromRGB(255, 255, 255)
                    autoTag.TextSize          = 8
                    autoTag.Font              = Enum.Font.GothamBold
                    autoTag.TextXAlignment    = Enum.TextXAlignment.Center
                    autoTag.Parent            = row
                    do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,3); c.Parent = autoTag end
                end

                -- invisible hitbox for click detection
                local hitbox = Instance.new("TextButton")
                hitbox.Size              = UDim2.new(1, 0, 1, 0)
                hitbox.BackgroundTransparency = 1
                hitbox.Text              = ""
                hitbox.Parent            = row

                local nmRef = nm
                hitbox.MouseButton1Click:Connect(function()
                    if cfgSelName == nmRef then
                        cfgSelName = ""
                    else
                        cfgSelName = nmRef
                        cfgNameBox.Text = nmRef
                    end
                    renderCfgList()
                end)
            end
            totalH = totalH + 26
        end
        cfgListScroll.CanvasSize         = UDim2.new(0, 0, 0, totalH)
        local visH = cfgListScroll.AbsoluteSize.Y
        cfgListScroll.ScrollBarThickness = (totalH > visH and visH > 0) and 4 or 0
    end

    -- ── Button logic ──────────────────────────────────────────────

    -- Save: captures current state; replaces existing config of same name
    cfgSaveBtn.MouseButton1Click:Connect(function()
        local nm = cfgNameBox.Text
        if nm == "" then return end
        cfgData[nm] = cfgGetState()
        cfgSaveFile()
        cfgSelName = nm
        renderCfgList()
    end)

    -- Load: apply selected config
    cfgLoadBtn.MouseButton1Click:Connect(function()
        if cfgSelName == "" or cfgData[cfgSelName] == nil then return end
        cfgSetState(cfgData[cfgSelName])
        cfgNameBox.Text = cfgSelName
    end)

    -- Auto Load: toggle auto-load for selected config (fires on next execute)
    cfgAutoLoadBtn.MouseButton1Click:Connect(function()
        if cfgSelName == "" then return end
        if cfgAutoName == cfgSelName then
            cfgAutoName = ""       -- toggle off
        else
            cfgAutoName = cfgSelName
        end
        cfgSaveFile()
        renderCfgList()
    end)

    -- Delete: remove selected config
    cfgDeleteBtn.MouseButton1Click:Connect(function()
        if cfgSelName == "" or cfgData[cfgSelName] == nil then return end
        cfgData[cfgSelName] = nil
        if cfgAutoName == cfgSelName then cfgAutoName = "" end
        cfgSaveFile()
        cfgSelName = ""
        cfgNameBox.Text = ""
        renderCfgList()
    end)

    -- ── Re-render list when Tab3 (Save Config) becomes active ────
    V.Tab3.MouseButton1Click:Connect(function()
        renderCfgList()
    end)

    -- ── Auto-load on script execute ───────────────────────────────
    if cfgAutoName ~= "" and cfgData[cfgAutoName] ~= nil then
        task.defer(function()
            cfgSetState(cfgData[cfgAutoName])
        end)
    end

end -- end SAVE CONFIG

