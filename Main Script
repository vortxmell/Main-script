    -- live leaderstats.Tower (contoh "tower floor: 51/51") sebagai trigger
    -- retreat TAMBAHAN — lebih responsive berbanding towerBest() sahaja.
    -- V2 punya atv2MonitorClimb TAK disentuh (dah confirmed jalan elok).
    local function atv3MonitorClimb(mods2, requirementFloor)
        local giveUp = tick() + AT2_CLIMB_TIMEOUT
        while V.autoTowerV3Enabled_af and tick() < giveUp do
            if atGetSkipBtn() then
                atFireDecline()
                local giveUp2 = tick() + 5
                while atGetSkipBtn() and tick() < giveUp2 do
                    task.wait(AT2_POLL_INTERVAL)
                end
                return "lost"
            end

            local liveFloor = atv3GetLiveTowerFloor()
            if liveFloor and liveFloor >= requirementFloor then
                atv2FireSurrender()
                return "retreated"
            end

            local towerBestNow = atv2GetTowerBest(mods2)
            if towerBestNow and towerBestNow >= requirementFloor then
                atv2FireSurrender()
                return "retreated"
            end

            task.wait(AT2_POLL_INTERVAL)
        end
        return "timeout"
    end

