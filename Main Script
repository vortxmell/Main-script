V.LogoBtn.InputChanged:Connect(function(input)
    if V.dragging and (input.UserInputType == Enum.UserInputType.Touch or
       input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - V.dragStart
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then V.dragMoved = true end
