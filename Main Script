    -- ═══ Auto Collect Scrap ═════════════════════════════════════
    -- Flow (dah test standalone sebelum ni — walk_test.lua,
    -- auto_collect_scrap.lua, speed_tracker.lua):
    --   1. Scan workspace.PitScrap:GetChildren() utk scrap yg ADA
    --      sekarang (live, bukan snapshot sekali) — dia spawn
    --      sikit-sikit bukan sekaligus.
    --   2. Walk pergi collect scrap TERDEKAT dulu (guna Humanoid:
    --      MoveTo() — sama macam manual touch/keyboard control,
    --      bukan CFrame teleport/glide).
    --   3. Setiap iteration, check WalkSpeed player DULU sebelum
    --      cari scrap — kalau dah turun ke <= 5.6 (mechanic game:
    --      makin banyak scrap collect, makin slow), terus walk ke
    --      workspace.Recyclers.Recycler1 utk recycle & speed restore.
    --   4. Lepas recycle, ulang balik dari step 1.
    local ACS_SCRAP_FOLDER    = "PitScrap"
    local ACS_RECYCLER_PATH   = {"Recyclers", "Recycler1"}
    local ACS_SPEED_THRESHOLD = 5.6  -- WalkSpeed <= ni → pergi recycle
    local ACS_WALK_TIMEOUT    = 15   -- saat; safety kalau MoveToFinished tak fire
    local ACS_COLLECT_WAIT    = 2    -- saat; confirm scrap dah collect (Parent hilang)
    local ACS_RECYCLE_WAIT    = 1.5  -- saat; tunggu lepas sampai recycler (proses recycle)
    local ACS_IDLE_WAIT       = 0.5  -- saat; tunggu bila takde scrap available

    V.acsEnabled_af = false
    local acsLoopRunning = false

    local function acsGetChar()
        local char = V.LocalPlayer.Character
        if not char then return nil, nil, nil end
        local hum  = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return nil, nil, nil end
        return char, hum, root
    end

    -- Posisi instance — support BasePart terus atau Model (PrimaryPart /
    -- GetPivot fallback). Dipakai utk scrap DAN recycler.
    local function acsGetPos(inst)
        if not inst or not inst.Parent then return nil end
        if inst:IsA("BasePart") then
            return inst.Position
        elseif inst:IsA("Model") then
            if inst.PrimaryPart then return inst.PrimaryPart.Position end
            local ok, cf = pcall(function() return inst:GetPivot() end)
            if ok and cf then return cf.Position end
        end
        return nil
    end

    local function acsGetNearestScrap(root)
        local folder = workspace:FindFirstChild(ACS_SCRAP_FOLDER)
        if not folder then return nil end
        local best, bestPos, bestDist
        for _, c in ipairs(folder:GetChildren()) do
            local pos = acsGetPos(c)
            if pos then
                local d = (root.Position - pos).Magnitude
                if not bestDist or d < bestDist then
                    best, bestPos, bestDist = c, pos, d
                end
            end
        end
        return best, bestPos
    end

    local function acsGetRecyclerPos()
        local node = workspace
        for _, name in ipairs(ACS_RECYCLER_PATH) do
            node = node and node:FindFirstChild(name)
        end
        return node and acsGetPos(node)
    end

    -- Walk guna MoveTo — respect toggle (stop serta-merta bila di-off).
    local function acsWalkTo(hum, root, targetPos, timeout)
        timeout = timeout or ACS_WALK_TIMEOUT
        hum:MoveTo(targetPos)
        local reached = false
        local conn
        conn = hum.MoveToFinished:Connect(function() reached = true end)
        local t0 = tick()
        while V.acsEnabled_af and not reached and (tick() - t0) < timeout do
            task.wait(0.1)
        end
        if conn.Connected then conn:Disconnect() end
    end

    local function acsRunLoop()
        if acsLoopRunning then return end
        acsLoopRunning = true
        task.spawn(function()
            while V.acsEnabled_af do
                local char, hum, root = acsGetChar()
                if not root then
                    task.wait(0.5)
                elseif hum.WalkSpeed <= ACS_SPEED_THRESHOLD then
                    local rPos = acsGetRecyclerPos()
                    if rPos then
                        acsWalkTo(hum, root, rPos, ACS_WALK_TIMEOUT)
                        local t0 = tick()
                        while V.acsEnabled_af and (tick() - t0) < ACS_RECYCLE_WAIT do
                            task.wait(0.1)
                        end
                    else
                        task.wait(0.5) -- recycler tak jumpa, retry
                    end
                else
                    local scrap, sPos = acsGetNearestScrap(root)
                    if scrap and sPos then
                        acsWalkTo(hum, root, sPos, ACS_WALK_TIMEOUT)
                        local t0 = tick()
                        while V.acsEnabled_af and scrap.Parent and (tick() - t0) < ACS_COLLECT_WAIT do
                            task.wait(0.1)
                        end
                    else
                        task.wait(ACS_IDLE_WAIT) -- takde scrap available skrg
                    end
                end
