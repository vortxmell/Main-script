    -- ═══ Auto Scrap + Rebirth (y=124) ═══════════════════════════════
    -- Flow (dah confirmed jalan via test_scrap_rebirth_v2.lua):
    --   1. Simpan posisi start.
    --   2. Loop collect 15 scrap — kalau takde scrap available skrg,
    --      KEEP RETRY SCAN (bukan give up) sampai scrap spawn.
    --   3. Balik ke start position (precise — retry-correct sampai
    --      betul2 dekat, MoveTo() punya tolerance agak longgar).
    --   4. Tunggu "ready to rebirth" true (poll, bukan sekali check).
    --   5. Tunggu chicken kembali dekat coop (poll).
    --   6. Walk ke recycler SAMBIL live-watch money — bila money mula
    --      naik (deposit scrap dikira), FIRE rebirth serta-merta (tak
    --      tunggu betul2 arrive recycler dulu).
    --   7. Lepas rebirth (atau timeout), balik ke start position asal.
    --   8. Ulang balik dari step 1, selagi toggle ON.
    --
    -- Reuse helper dari Auto Collect Scrap (acsGetChar/acsGetPos/
    -- acsGetNearestScrap/acsGetRecyclerPos) dan Auto Tower V3
    -- (atGetMyCoop/atv2GetModules/atv2GetRequirementFloor/
    -- atv2GetTowerBest) — semua plain local dlm scope AUTO FARM yg
    -- sama, jadi boleh terus dipanggil di sini.
    local ASR_TARGET_SCRAP        = 15
    local ASR_COLLECT_WAIT        = 2
    local ASR_WALK_TIMEOUT        = 15
    local ASR_SCAN_RETRY_WAIT     = 1    -- saat antara re-scan bila takde scrap
    local ASR_PRECISE_THRESHOLD   = 1.5  -- studs — dianggap "sampai" utk return-to-start
    local ASR_PRECISE_MAX_RETRY   = 5
    local ASR_READY_POLL_INTERVAL = 2    -- saat antara poll ready-to-rebirth / chicken-at-coop
    local ASR_MONEY_POLL_INTERVAL = 0.05 -- 50ms — secepat mungkin detect duit masuk
    local ASR_MONEY_WAIT_TIMEOUT  = 15
    local ASR_MIN_SAFE_DIST_RECYCLER = 15 -- studs
    local ASR_MIN_SAFE_DIST_COOP_PAD = 5  -- studs, padding luar bounding box coop

    V.asrEnabled_af = false
    local asrLoopRunning = false

    -- Walk yg respect toggle V.asrEnabled_af sendiri (BUKAN reuse
    -- acsWalkTo terus — acsWalkTo punya loop tied ke V.acsEnabled_af,
    -- toggle Auto Collect Scrap yg lain, boleh exit awal kalau toggle
    -- tu OFF walaupun Auto Scrap+Rebirth tengah jalan).
    local function asrWalkTo(hum, root, targetPos, timeout)
        timeout = timeout or ASR_WALK_TIMEOUT
        hum:MoveTo(targetPos)
        local reached = false
        local conn
        conn = hum.MoveToFinished:Connect(function() reached = true end)
        local t0 = tick()
        while V.asrEnabled_af and not reached and (tick() - t0) < timeout do
            task.wait(0.1)
        end
        if conn.Connected then conn:Disconnect() end
    end

    local function asrWalkToPrecise(hum, root, targetPos, timeout)
        for _ = 1, ASR_PRECISE_MAX_RETRY do
            if not V.asrEnabled_af then return false end
            asrWalkTo(hum, root, targetPos, timeout)
            local dist = (root.Position - targetPos).Magnitude
            if dist <= ASR_PRECISE_THRESHOLD then return true end
        end
        return false
    end

    -- Containment check betul-betul "dalam" coop (bukan sekadar dekat
    -- dengan satu titik) — guna bounding box coop tu sendiri. Chicken
    -- baru turun boleh je muncul dalam radius X studs dari coop tapi
    -- belum betul-betul masuk/berdiri dalam coop — distance-to-point
    -- check lama bagi false-positive utk kes ni.
    local function asrIsPosInsideCoop(position, coopModel)
        local ok, cf, size = pcall(function() return coopModel:GetBoundingBox() end)
        if not ok or not cf or not size then return false end
        local rel = cf:PointToObjectSpace(position)
        local half = size / 2
        return math.abs(rel.X) <= half.X
           and math.abs(rel.Z) <= half.Z
           and rel.Y >= -half.Y - 5
           and rel.Y <= half.Y + 15
    end

    local function asrIsChickenAtCoop()
        local coop, plot = atGetMyCoop()
        if not coop or not plot then return false end
        local bodies = workspace:FindFirstChild("ChickenBodies")
        if not bodies then return false end
        for _, body in ipairs(bodies:GetChildren()) do
            if body.Name:find("coop:" .. tostring(plot), 1, true) then
                local p = acsGetPos(body)
                if p then
                    return asrIsPosInsideCoop(p, coop)
                end
            end
        end
        return false
    end

    -- Safety-check jarak minimum dari recycler & tapak coop — dinamik.
    local function asrIsPosSafe(pos)
        local rPos = acsGetRecyclerPos()
        if rPos and (pos - rPos).Magnitude < ASR_MIN_SAFE_DIST_RECYCLER then
            return false, "terlalu dekat recycler"
        end
        local coop = atGetMyCoop()
        if coop then
            local ok, cf, size = pcall(function() return coop:GetBoundingBox() end)
            if ok and cf and size then
                local rel = cf:PointToObjectSpace(pos)
                local half = size / 2
                if math.abs(rel.X) <= half.X + ASR_MIN_SAFE_DIST_COOP_PAD
                   and math.abs(rel.Z) <= half.Z + ASR_MIN_SAFE_DIST_COOP_PAD
                   and rel.Y >= -half.Y - 5 and rel.Y <= half.Y + 15 then
                    return false, "dalam/terlalu dekat tapak coop"
                end
            end
        end
        return true, nil
    end

    local function asrGetMoney()
        local ok, result = pcall(function()
            local DataController = require(V.LocalPlayer:WaitForChild("PlayerScripts").Core.Data.DataController)
