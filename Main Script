-- ========================
-- DRAG FRAME LOGIC
-- ========================

V.frameDragging = false

local function setupDrag(dragSource)
    dragSource.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or
           input.UserInputType == Enum.UserInputType.MouseButton1 then
            V.frameDragging = true
            V.frameDragStart = input.Position
            V.frameStartPos = V.MainFrame.Position
        end
    end)
    dragSource.InputChanged:Connect(function(input)
        if V.frameDragging and (input.UserInputType == Enum.UserInputType.Touch or
           input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - V.frameDragStart
            V.MainFrame.Position = UDim2.new(
                V.frameStartPos.X.Scale,
                V.frameStartPos.X.Offset + delta.X,
                V.frameStartPos.Y.Scale,
                V.frameStartPos.Y.Offset + delta.Y
            )
        end
    end)
    dragSource.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or
           input.UserInputType == Enum.UserInputType.MouseButton1 then
            V.frameDragging = false
        end
    end)
end

-- ========================
-- RESIZE HANDLES
-- ========================

V.MIN_W, V.MIN_H = 250, 180
V.resizing = false
V.resizeCorner = nil
V.resizeStart = nil
V.resizeStartSize = nil
V.resizeStartPos = nil

V.CORNERS = {
    { name = "TL", ax = 0, ay = 0 },
    { name = "BL", ax = 0, ay = 1 },
    { name = "BR", ax = 1, ay = 1 },
}
V.HANDLE_SIZE = 28

for _, c in ipairs(V.CORNERS) do
    local handle = Instance.new("TextButton")
    handle.Name = "ResizeHandle_" .. c.name
    handle.Size = UDim2.new(0, V.HANDLE_SIZE, 0, V.HANDLE_SIZE)
    handle.Position = UDim2.new(
        c.ax, c.ax == 1 and -V.HANDLE_SIZE or 0,
        c.ay, c.ay == 1 and -V.HANDLE_SIZE or 0
    )
    handle.BackgroundTransparency = 1
    handle.Text = ""
    handle.ZIndex = 10
    handle.Parent = V.MainFrame

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch and
           input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        V.resizing = true
        V.resizeCorner = c
        V.resizeStart = input.Position
        V.resizeStartSize = Vector2.new(V.MainFrame.AbsoluteSize.X, V.MainFrame.AbsoluteSize.Y)
        V.resizeStartPos = Vector2.new(V.MainFrame.AbsolutePosition.X, V.MainFrame.AbsolutePosition.Y)
    end)
end

V.UserInputService.InputChanged:Connect(function(input)
    if not V.resizing then return end
    if input.UserInputType ~= Enum.UserInputType.Touch and
       input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

    local delta = input.Position - V.resizeStart
    local c = V.resizeCorner
    local newW = c.ax == 1
        and math.max(V.MIN_W, V.resizeStartSize.X + delta.X)
        or  math.max(V.MIN_W, V.resizeStartSize.X - delta.X)
    local newH = c.ay == 1
        and math.max(V.MIN_H, V.resizeStartSize.Y + delta.Y)
        or  math.max(V.MIN_H, V.resizeStartSize.Y - delta.Y)
    local newX = c.ax == 0 and (V.resizeStartPos.X + (V.resizeStartSize.X - newW)) or V.resizeStartPos.X
    local newY = c.ay == 0 and (V.resizeStartPos.Y + (V.resizeStartSize.Y - newH)) or V.resizeStartPos.Y

    V.MainFrame.Size = UDim2.new(0, newW, 0, newH)
    V.MainFrame.Position = UDim2.new(0, newX, 0, newY)
end)

V.UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Touch and
       input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    V.resizing = false
    V.resizeCorner = nil
end)

