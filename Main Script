    -- ── Follow logic: move LocalPlayer behind nearest selected target ─
    local function startFollow()
        flwEnabled = true
        updateFlwPill(true)
        if flwConn then flwConn:Disconnect() end
        flwConn = V.RunService.Heartbeat:Connect(function()
            if #flwTargets == 0 then return end
            local myChar = V.LocalPlayer.Character
            local myHrp  = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myHrp then return end
            -- Find nearest selected target
            local nearest, nearestDist = nil, math.huge
            for _, t in ipairs(flwTargets) do
                local tc  = t.Character
                local tHrp = tc and tc:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    local d = (myHrp.Position - tHrp.Position).Magnitude
                    if d < nearestDist then
                        nearestDist = d
                        nearest = tHrp
                    end
                end
            end
            if nearest then
                -- +Z in CFrame space = behind the character
                pcall(function()
                    myHrp.CFrame = nearest.CFrame * CFrame.new(0, 0, flwDist)
                end)
            end
        end)
    end

    local function stopFollow()
        flwEnabled = false
        updateFlwPill(false)
        if flwConn then flwConn:Disconnect(); flwConn = nil end
    end

