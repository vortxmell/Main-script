local function setActiveTab(activeTab)
    V.Tab1.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    V.Tab1.TextColor3 = Color3.fromRGB(180, 180, 180)
    V.Tab2.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    V.Tab2.TextColor3 = Color3.fromRGB(180, 180, 180)
    V.Tab3.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    V.Tab3.TextColor3 = Color3.fromRGB(180, 180, 180)
    activeTab.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    activeTab.TextColor3 = Color3.fromRGB(255, 255, 255)

    local isCheatHub = (activeTab == V.Tab2)
    local isAutoFarm = (activeTab == V.Tab1)
    local isSaveCfg  = (activeTab == V.Tab3)
    V.Tab2Content.Visible       = isCheatHub
    V.Tab2RightContent.Visible  = isCheatHub
    V.Tab3AFContent.Visible     = isAutoFarm
    V.Tab4ContentPanel.Visible  = isSaveCfg
    V.ContentPanelLeft.Visible  = not isSaveCfg
    -- FIX (item 1): dulu ContentDivider & ContentPanelRight di-HIDE terus
    -- masa Auto Farm tab, infoPanel (Live Info) kena buat panel floating
    -- berasingan dgn hardcoded size sendiri (tu punca dia tak ikut resize).
    -- Sekarang reuse terus ContentPanelRight (sama macam CheatHub punya
    -- Teleport/Anti/Server panel) — visible utk both tab, isi dia je yg
    -- tukar (Tab2RightContent utk CheatHub, LiveInfoPanel utk Auto Farm).
    V.ContentDivider.Visible    = not isSaveCfg
    V.ContentPanelRight.Visible = not isSaveCfg

    -- Live Info panel (kanan, Auto Farm tab) — kini child ContentPanelRight
    if V.LiveInfoPanel then
        V.LiveInfoPanel.Visible = isAutoFarm
    end

    if V.SearchBarContainer then
        V.SearchBarContainer.Visible = isCheatHub
    end
    if not isCheatHub and V.SearchBar then
        V.SearchBar.Text = ""
    end
end

