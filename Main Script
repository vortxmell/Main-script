end

local function doMaximize()
    V.minimized = false
    local lp = V.LogoBtn.AbsolutePosition
    V.MainFrame.Position = UDim2.new(0, lp.X + 14, 0, lp.Y + 14)
    V.MainFrame.Size = UDim2.new(0, 0, 0, 0)
    V.MainFrame.BackgroundTransparency = 1
    V.MainFrame.Visible = true
    V.TweenService:Create(V.MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 500, 0, 335),
        Position = UDim2.new(0.5, -250, 0.5, -167),
        BackgroundTransparency = V.BG_TRANSPARENCY
    }):Play()
end

V.MinBtn.MouseButton1Click:Connect(function()
    if V.minimized then return end
    doMinimize()
end)
V.LogoBtn.MouseButton1Click:Connect(function()
    if V.dragMoved then return end
    if V.minimized then doMaximize() else doMinimize() end
end)

