    local function wtSerializeList()
        local out = {}
        for _, w in ipairs(wallList) do
            table.insert(out, {
                name = w.name,
                sPos = {x = w.sPos.X, y = w.sPos.Y, z = w.sPos.Z},
                ePos = {x = w.ePos.X, y = w.ePos.Y, z = w.ePos.Z},
                h = w.h, t = w.t,
                cfc = {w.cf:GetComponents()}, -- cframe tepat, elak drift kalau wallYOffset default berubah lepas ni
            })
        end
        return out
    end

    local function wtSpawnEntryPart(w, folder)
        local part = Instance.new("Part")
        part.Size        = Vector3.new(w.t, w.h, w.len)
        part.CFrame      = w.cf
        part.Anchored    = true
        part.CanCollide  = true
        part.BrickColor  = BrickColor.new("Bright red")
        part.Material    = Enum.Material.SmoothPlastic
        part.Transparency = 0.35
        part.Name        = "_WT_Wall_" .. w.name
        part.Parent      = folder
        w.part = part
        return part
    end

    local function wtDeserializeAndSpawn(arr)
        local folder = workspace:FindFirstChild("_WallTools")
        if not folder then
            folder = Instance.new("Folder")
            folder.Name = "_WallTools"
            folder.Parent = workspace
        end
        local out = {}
        for _, e in ipairs(arr or {}) do
            if type(e) == "table" and e.sPos and e.ePos then
                local sPos = Vector3.new(e.sPos.x or 0, e.sPos.y or 0, e.sPos.z or 0)
                local ePos = Vector3.new(e.ePos.x or 0, e.ePos.y or 0, e.ePos.z or 0)
                local cf
                if type(e.cfc) == "table" and #e.cfc == 12 then
                    local ok, built = pcall(CFrame.new, table.unpack(e.cfc))
                    cf = ok and built or nil
                end
                if not cf then
                    cf = buildWallCF(sPos, ePos, e.h or wallH)
                end
                local entry = {
                    part = nil,
                    name = e.name or "Wall",
                    sPos = sPos, ePos = ePos,
                    h = e.h or wallH, t = e.t or wallT,
                    len = (ePos - sPos).Magnitude,
                    cf = cf,
                }
                wtSpawnEntryPart(entry, folder)
                table.insert(out, entry)
            end
        end
        return out
    end

    local function wtPersist()
        _G._VORT_WALLS = wtSerializeList()
