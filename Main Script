    -- ── MovingWall (Stage9) — 6 row pair, gerak Z, wave depan→belakang.
    -- Geometri (dari scan + Size check Mel):
    --   Size semua wall = (70, 58, 85) → thickness relevan = Size.Z = 85
    --   Kanan: retract Z=1407.01 (selamat) ↔ extend Z=1457.01 (bahaya)
    --   Kiri : retract Z=1564.98 (selamat) ↔ extend Z=1514.98 (bahaya)
    --   gap0 (bila DUA-DUA retract penuh) = 72.97 studs
    --   offset magnitude pergerakan setiap wall = 50 studs
    -- "Selamat" = gap = kiri.Z - kanan.Z - 85 >= margin.
    --
    -- UPDATE (dari decompile Pièges.MovingWallsW3 — ground truth): wall ni
    -- BUKAN gerak continuous macam kita anggap dulu — dia TWEEN PANTAS
    -- (TweenTime=0.3s) then DUDUK DIAM (dwell, ReturnTime=1.35s) kat setiap
    -- hujung. totalCycle = 2*TweenTime + 2*ReturnTime = 3.3s (match scan).
    -- DelayBetweenWalls=0.35s per row (match scan punya ~0.356s).
    -- v19(t) = "extend fraction" 0(retract/selamat)..1(extend/bahaya):
    --   [0,Tween)            : ramp naik 0→1 (extending)
    --   [Tween,Tween+Dwell)  : 1 (dwell extended)
    --   [+,+2Tween+Dwell)    : ramp turun 1→0 (retracting)
    --   [terus sampai total) : 0 (dwell retracted, SELAMAT)
    -- gap(t) = gap0 - offsetMag*(v19_kanan(t) + v19_kiri(t))  — deterministic
    -- 100%, tak payah poll/estimate lagi (sama pattern macam tsunami/lava).
    -- CycleStartTime/TweenTime/ReturnTime/DelayBetweenWalls dibaca LIVE
    -- dari attribute model (fallback ke nilai confirmed di atas kalau
    -- attribute tak wujud/struktur tak match — jangan patah).
    local RB_WALL9_THICKNESS_Z    = 85   -- Size.Z, confirmed
    local RB_WALL9_GAP0           = 72.97 -- studs, gap bila kedua2 retract penuh (confirmed dari geometri)
    local RB_WALL9_OFFSET_MAG     = 50.0  -- studs, magnitude pergerakan tiap wall (confirmed dari scan)
    local RB_WALL9_DEFAULT_MARGIN = 20   -- studs buffer (boleh override via UI, "Safe Dist" box)
    local RB_WALL9_LOOKAHEAD_CAP  = 6.0  -- saat, had ATAS pengiraan (bukan syarat lulus)
    local RB_WALL9_LOOKAHEAD_STEP = 0.1
    local RB_WALL9_MIN_CROSS_TIME = 0.8  -- saat, baki masa selamat MINIMUM sblm dibenarkan "go"
    local rbWall9FallbackWarned   = false -- throttle print

    local function getStage9WallPair(index)
        local ok, res = pcall(function()
            local Stage9 = workspace.Structure.Stage9
            local rightFolder = Stage9:FindFirstChild("MovingWalls")
            local leftFolder  = Stage9:GetChildren()[7]
            local r = rightFolder and rightFolder:FindFirstChild("MovingWall" .. index)
            local l = leftFolder and leftFolder:FindFirstChild("MovingWall" .. index)
            if r and not r:IsA("BasePart") then r = r:FindFirstChildWhichIsA("BasePart", true) end
            if l and not l:IsA("BasePart") then l = l:FindFirstChildWhichIsA("BasePart", true) end
            return {r = r, l = l}
        end)
        if not ok then return nil, nil end
        return res.r, res.l
    end

    -- Model bertag "MovingWallModelW3" berasingan utk setiap side (kanan =
    -- folder "MovingWalls", kiri = folder GetChildren()[7]) — masing2 ada
    -- attribute CycleStartTime/TweenTime/ReturnTime/DelayBetweenWalls sendiri.
    local function rbGetWallSideModel_af(side)
        local ok, Stage9 = pcall(function() return workspace.Structure.Stage9 end)
        if not ok or not Stage9 then return nil end
        if side == "right" then
            return Stage9:FindFirstChild("MovingWalls")
        else
            local children = Stage9:GetChildren()
            return children[7]
        end
    end

    -- v19(t+futureOffset): 0=retract/selamat, 1=extend/bahaya, utk row
    -- tertentu. Pulang nil kalau attribute CycleStartTime tak wujud
    -- (struktur tak match sangkaan kita).
    local function rbWallExtendFraction(model, rowIndex, futureOffset)
        if not model then return nil end
        local ok, v19 = pcall(function()
            local cycleStart = model:GetAttribute("CycleStartTime")
            if not cycleStart then return nil end
            local tweenTime = model:GetAttribute("TweenTime")         or 0.3
            local dwellTime = model:GetAttribute("ReturnTime")        or 1.35
            local delayEach = model:GetAttribute("DelayBetweenWalls") or 0.35
            local total = tweenTime * 2 + dwellTime * 2
            if total <= 0 then return nil end
            local timeOffset = (rowIndex - 1) * delayEach
            local now = workspace:GetServerTimeNow()
            local t = (now + (futureOffset or 0) - cycleStart - timeOffset) % total
            if t < 0 then t = t + total end
            if t < tweenTime then
                return t / tweenTime
            elseif t < tweenTime + dwellTime then
                return 1
            elseif t < tweenTime * 2 + dwellTime then
                return 1 - (t - tweenTime - dwellTime) / tweenTime
            else
                return 0
            end
        end)
        if not ok then return nil end
        return v19
    end

    -- Kira baki masa (saat) dari SEKARANG sebelum gap row ni jatuh bawah
    -- margin buat kali seterusnya. Pulang 0 kalau dah unsafe SEKARANG,
    -- nil kalau model/attribute tak match (utk trigger fallback).
    local function rbWall9RemainingSafeTime(rowIndex, margin)
        local rightModel = rbGetWallSideModel_af("right")
        local leftModel  = rbGetWallSideModel_af("left")
        if not rightModel or not leftModel then return nil end

        local v19r0 = rbWallExtendFraction(rightModel, rowIndex, 0)
        local v19l0 = rbWallExtendFraction(leftModel, rowIndex, 0)
        if v19r0 == nil or v19l0 == nil then return nil end

        local ok, remaining = pcall(function()
            local gapNow = RB_WALL9_GAP0 - RB_WALL9_OFFSET_MAG * (v19r0 + v19l0)
            if gapNow < margin then return 0 end
            local t = RB_WALL9_LOOKAHEAD_STEP
            while t <= RB_WALL9_LOOKAHEAD_CAP do
                local v19r = rbWallExtendFraction(rightModel, rowIndex, t)
                local v19l = rbWallExtendFraction(leftModel, rowIndex, t)
                if v19r == nil or v19l == nil then return nil end
                local gap = RB_WALL9_GAP0 - RB_WALL9_OFFSET_MAG * (v19r + v19l)
                if gap < margin then return t end
                t = t + RB_WALL9_LOOKAHEAD_STEP
            end
            return RB_WALL9_LOOKAHEAD_CAP
        end)
        if not ok then return nil end
        return remaining
    end

    for wallRow = 1, 6 do
        local rowKey = "movingwall_stage9_row" .. wallRow
        RB_HAZARDS[rowKey] = {
            label = "MovingWall Stage9 R" .. wallRow,
            thresholdType = "distance",
            getPart = function()
                local r = getStage9WallPair(wallRow)
                return r
            end,
            isSafe = function(_part, wp)
                local margin = wp.avoidSafeDist or RB_WALL9_DEFAULT_MARGIN

                -- Utamakan model EXACT (server-time based, adaptive).
                local remaining = rbWall9RemainingSafeTime(wallRow, margin)
                if remaining ~= nil then
                    local safe = remaining >= RB_WALL9_MIN_CROSS_TIME
                    if safe then
                        print(string.format(
                            "[RB WALL9] row%d path=EXACT | baki masa selamat=%.1fs (perlu>=%.1fs) | SAFE, sambung jalan",
                            wallRow, remaining, RB_WALL9_MIN_CROSS_TIME))
                    end
                    return safe
                end

                -- Fallback: attribute tak match sangkaan kita — jangan
                -- patah, guna live-position gap check lama.
                if not rbWall9FallbackWarned then
                    rbWall9FallbackWarned = true
                    print("[RB WALL9] path=FALLBACK (CycleStartTime/attribute tak match — guna live-position check lama)")
                end
                local r, l = getStage9WallPair(wallRow)
                if not r or not l then return true end -- part hilang, jgn stuck
                local gap = l.Position.Z - r.Position.Z - RB_WALL9_THICKNESS_Z
                return gap >= margin
            end,
        }
        table.insert(RB_HAZARD_ORDER, rowKey)
    end

    -- Tunggu sampai hazard kat wp.avoid selamat sebelum sambung segment
    -- seterusnya. maxWait = failsafe (elak stuck selamanya kalau part
    -- hilang/config salah — better teruskan drpd freeze auto farm).
    local function rbWaitHazardSafe(wp)
        if not wp or not wp.avoid then return end
        local hz = RB_HAZARDS[wp.avoid]
        if not hz then return end
        local part = hz.getPart()
        if not part then return end
        local maxWait = 15
        local t0 = tick()
        while rbAutoRouteActive and (tick() - t0) < maxWait do
            local ok, safe = pcall(hz.isSafe, part, wp)
            if ok and safe then return end
            task.wait(0.1)
        end
    end

    -- ── Hazard "closest approach" monitor (VALIDATION TOOL) ────────────
    -- Bug macam tsunami collision ni jarang jadi, so susah nak confirm
    -- fix betul2 berkesan cuma dari "test run & tengok". Ni track jarak
    -- SEBENAR (live game state, BUKAN simulasi kita — ground truth) antara
    -- player & hazard SEPANJANG segment "distance"-type (cth tsunami)
    -- berjalan, then print angka margin lepas setiap run. Kalau margin
    -- consistently jauh (cth 20-40 studs) merentas byk run, tu confidence
    -- kuat fix berkesan — tak payah tunggu collision utk tahu.
    local rbHazardMonitorStats = {} -- [hazardKey] = {runs, minEver, nearMissCount}
    local RB_NEAR_MISS_STUDS = 15 -- studs, ambang "near-miss" (cuma utk warning label)

    local function rbMonitorHazardDuringSegment(hazardKey, fn)
        local hz = RB_HAZARDS[hazardKey]
        if not hz or hz.thresholdType ~= "distance" then
            return fn() -- hazard type ni takde axis distance, monitor skip
        end

        local stats = rbHazardMonitorStats[hazardKey]
        if not stats then
            stats = {runs = 0, minEver = math.huge, nearMissCount = 0}
            rbHazardMonitorStats[hazardKey] = stats
        end

        local axisKey    = (hz.axis or "x"):upper()
        local minThisRun = math.huge
        local monitoring = true
        local conn = game:GetService("RunService").Heartbeat:Connect(function()
            if not monitoring then return end
            pcall(function()
                local part = hz.getPart()
                local char = V.LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if part and root then
                    local d = math.abs(root.Position[axisKey] - part.Position[axisKey])
                    if d < minThisRun then minThisRun = d end
                end
            end)
        end)

        local result = fn()

        monitoring = false
        conn:Disconnect()

        if minThisRun < math.huge then
            stats.runs = stats.runs + 1
            if minThisRun < stats.minEver then stats.minEver = minThisRun end
            local nearMiss = minThisRun < RB_NEAR_MISS_STUDS
            if nearMiss then stats.nearMissCount = stats.nearMissCount + 1 end
            print(string.format(
                "[RB HAZARD MONITOR] %s | run#%d closest=%.1f studs | min-ever=%.1f | near-miss(<%d)=%d/%d%s",
                hz.label, stats.runs, minThisRun, stats.minEver, RB_NEAR_MISS_STUDS,
                stats.nearMissCount, stats.runs, nearMiss and " ⚠️" or ""))
        end

        return result
    end
