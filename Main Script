    local function rbTestMove(fromPos, toPos, skipTeleport)
        local char = V.LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return false end

        -- Death/respawn guard: kalau character mati/berubah masa tengah
        -- move ni, STOP terus — jangan cuba sambung/koreksi apa2. Return
        -- false supaya rbRunRoute tahu abort seluruh route, bukan proceed
        -- ke segment lepas guna character BARU (lobby) yg posisi dia lain
        -- terus — tu punca player "terbang jauh" lepas respawn.
        local died = false
        local diedConn
        pcall(function() diedConn = hum.Died:Connect(function() died = true end) end)

        if not skipTeleport then
            root.CFrame = CFrame.new(fromPos)
            task.wait(0.2)
        end

        -- FIX (confirmed via standalone movement test): hum:MoveTo() buat
        -- character gerak scr fizikal tapi TAK trigger step-award server
        -- (server rupanya dengar MoveDirection/state "Walking" biasa, bukan
        -- event MoveTo). Punca asal Method 2 (hum:Move() per-frame) nampak
        -- "gagal gerak" masa test standalone: default PlayerModule punya
        -- ControlModule masih aktif dan "menang race" — dia call
        -- hum:Move(Vector3.zero) balik SETIAP frame sebab takde input
        -- sebenar, so MoveDirection asyik ke-reset zero sblm physics
        -- translate. Fix: disable ControlModule masa auto-walk (+ hook
        -- balik jump manual sebab disable tu matikan jump button skali),
        -- then guna hum:Move() per-frame gantikan MoveTo().
        local controls = V.getControls_af and V.getControls_af()
        if controls then pcall(function() controls:Disable() end) end

        local jumpConn
        pcall(function()
            jumpConn = V.UserInputService.JumpRequest:Connect(function()
                local c = V.LocalPlayer.Character
                local h = c and c:FindFirstChildOfClass("Humanoid")
                if h then h.Jump = true end
            end)
        end)

        -- Anti-overshoot: MoveTo() lama ada built-in deceleration dekat
        -- target, so tak overshoot. hum:Move() kita kira arah PENUH speed
        -- setiap frame — bila dah dekat target (~4 studs) dia terlajak
        -- lepas titik tu, frame lepas arah terbalik (target kat belakang),
        -- character pusing balik → terlajak arah lain → pusing lagi ("cari
        -- checkpoint"). Fix: (1) stop radius ikut jarak sebenar character
        -- boleh cover dlm satu frame (WalkSpeed * dt) + buffer, supaya tak
        -- sentiasa overshoot-correct; (2) smooth arah guna Lerp instead of
        -- snap terus, elak flip drastik bila dah dekat target.
        -- Stop radius: fixed 4 studs — sama macam arrival check MoveTo()
        -- lama ((root.Position - toPos).Magnitude < 4), supaya character
        -- jalan sedekat/sejauh yg sama macam dulu, bukan stop awal ikut
        -- WalkSpeed (formula dynamic sblm ni buat radius membesar bila
        -- WalkSpeed tinggi, cth masa Match Speed override).
        -- Punca sebenar "pusing cari checkpoint": character gerak FULL
        -- speed ke arah target sentiasa, so bila dah dekat, sudut ke
        -- target berubah laju (sikit pergerakan = lantunan sudut besar)
        -- → asyik overshoot+koreksi → orbit sekeliling titik, tak pernah
        -- betul2 masuk radius (naikkan STOP_RADIUS tak bantu sebab spin
        -- jadi kat LUAR radius tu). Fix cara MoveTo() sebenar buat:
        -- DECELERATE ikut jarak (bukan hanya smooth arah) — bila makin
        -- dekat, speed makin perlahan, so natural masuk terus tanpa
        -- overshoot, takyah turning tajam last-second yg buat spin.
        local giveUp     = tick() + 10
        local lastDir     = nil
        local STOP_RADIUS = 20
        local DECEL_RADIUS = 2 -- jarak mula slow down
        while tick() < giveUp do
            -- FIX: check rbAutoRouteActive skali (bukan setakat died/char
            -- berubah/root gone) — sebelum ni loop movement ni TERUS jalan
            -- (hum:Move() tiap frame) walaupun rbStopSavedRouteLoop() dah
            -- dipanggil dari luar (cth Auto TP Event Treadmill), sebab
            -- flag tu cuma di-check ANTARA waypoint, bukan DALAM loop ni.
            -- Punca race: TP ke conveyor treadmill jalan serentak dgn
            -- route yg masih cuba "tarik" character balik ke waypoint
            -- lama sampai 10s giveUp → ping-pong keluar-masuk conveyor.
            if died or V.LocalPlayer.Character ~= char or not root.Parent or not rbAutoRouteActive then
                died = true
                break
            end
            task.wait()
            local delta = toPos - root.Position
            if delta.Magnitude < STOP_RADIUS then break end
            local flat = Vector3.new(delta.X, 0, delta.Z)
            if flat.Magnitude > 0.1 then
                local targetDir  = flat.Unit
                lastDir = lastDir and lastDir:Lerp(targetDir, 0.5).Unit or targetDir
                -- speedScale: 1 bila jauh, turun linear bila masuk DECEL_RADIUS,
                -- floor 0.25 supaya tetap ada momentum masuk (elak stuck/stall)
                local speedScale = math.clamp(flat.Magnitude / DECEL_RADIUS, 0.4, 1)
                pcall(function() hum:Move(lastDir * speedScale, false) end)
            end
        end
        pcall(function() if hum then hum:Move(Vector3.new(0,0,0), false) end end)

        if jumpConn then jumpConn:Disconnect() end
        if controls then pcall(function() controls:Enable() end) end
        if diedConn then diedConn:Disconnect() end
        return not died
    end

    local function rbTestJump(fromPos, toPos, airTime, skipTeleport)
        local char = V.LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return false end

        -- Death/respawn guard — sama sebab macam rbTestMove.
        local died = false
        local diedConn
        pcall(function() diedConn = hum.Died:Connect(function() died = true end) end)

        if not skipTeleport then
            root.CFrame = CFrame.new(fromPos)
            task.wait(0.3)
        end

        local g         = workspace.Gravity
        local totalTime = airTime or 0.7
        local startTick = tick()

        hum.PlatformStand = true

        -- ── Homing re-aim: velocity dikira SEMULA setiap frame ikut ────
        -- posisi SEBENAR player masa tu (bukan sekali je dari fromPos).
        -- Ni yang buat landing tetap tepat walaupun trajectory terganggu
        -- sikit (naik bukit, langgar tepi something, dll) — sebab tiap
        -- frame dia auto-koreksi kira semula "baki jarak / baki masa".
        local landed = false
        local conn
        conn = V.RunService.Heartbeat:Connect(function()
            if landed then return end
            -- FIX: sama isu macam rbTestMove — check rbAutoRouteActive
            -- supaya jump segment pun stop serta-merta bila external stop
            -- dipanggil (bukan tunggu totalTime+2s timeout).
            if died or V.LocalPlayer.Character ~= char or not root.Parent or not rbAutoRouteActive then
                died = true
                landed = true
                if conn then conn:Disconnect() end
                return
            end
            local elapsed   = tick() - startTick
            local remaining = math.max(totalTime - elapsed, 0.05) -- floor elak /0 & spike

            local pos  = root.Position
            local diff = toPos - pos
            local dH   = Vector3.new(diff.X, 0, diff.Z).Magnitude
            local dY   = diff.Y
            local vH   = dH / remaining
            local vY   = (dY + 0.5 * g * remaining * remaining) / remaining
            local hDir = (dH > 0.05) and Vector3.new(diff.X, 0, diff.Z).Unit or Vector3.new(0,0,0)
            root.AssemblyLinearVelocity = hDir * vH + Vector3.new(0, vY, 0)
            root.AssemblyAngularVelocity = Vector3.new(0,0,0) -- elak spin dari collision impulse platform senget

            -- Landing: dekat betul2 dgn target (3 axis) — check jarak
            -- SEBENAR ke toPos (bukan cuma Y height je macam dulu, ni
            -- yang buat "landed" jadi tepat kat target, bukan kat mana2
            -- je bila Y dekat)
            local closeEnough = (pos - toPos).Magnitude < 3.5 and elapsed > 0.15
            if closeEnough or elapsed >= totalTime + 0.4 then
                hum.PlatformStand = false
                landed = true
                conn:Disconnect()
            end
        end)
        task.delay(totalTime + 2, function()
            if not landed then
                hum.PlatformStand = false
                landed = true
                if conn then conn:Disconnect() end
            end
        end)
        while not landed do
            V.RunService.Heartbeat:Wait()
        end
        if diedConn then diedConn:Disconnect() end
        pcall(function() if hum then hum.PlatformStand = false end end)
        return not died
    end

    -- ── Match Speed helper: override WalkSpeed sementara ikut speed
    -- hazard (cth tsunami), lapis SEMUA enforcer yang mungkin aktif
    -- (Movement "WalkSpeed" toggle DAN Win Farm punya speed watcher) —
    -- kalau just set hum.WalkSpeed terus, enforcer2 ni auto revert balik
    -- serta-merta (ni la sebab override asal "tak jalan" walaupun dah set).
    -- Return function() utk restore balik lepas movement selesai.
    local function rbApplySpeedMatch(seg)
        if not seg or not seg.speedMatch then return function() end end
        local hz = RB_HAZARDS[seg.speedMatch]
        if not hz or not hz.getSpeed then return function() end end
        local part = hz.getPart and hz.getPart()
        if not part then return function() end end
        local ok, spd = pcall(hz.getSpeed, part)
        if not ok or type(spd) ~= "number" or spd <= 0 then return function() end end

        local restoreFns = {}

        -- Layer 1: Movement dropdown "WalkSpeed" toggle
        if V.wsIsEnabled and V.wsIsEnabled() and V.wsSetSpeedRaw and V.wsGetSpeed then
            local prev = V.wsGetSpeed()
            V.wsSetSpeedRaw(spd)
            table.insert(restoreFns, function() V.wsSetSpeedRaw(prev) end)
        end

        -- Layer 2: Win Farm punya WalkSpeed enforcer (official setter
        -- dia V.applyWalkSpeed_af(), bukan clamp macam slider UI)
        if V.wfWalkSpeed_af ~= nil and V.applyWalkSpeed_af then
            local prev = V.wfWalkSpeed_af
            V.wfWalkSpeed_af = spd
            pcall(V.applyWalkSpeed_af)
            table.insert(restoreFns, function()
                V.wfWalkSpeed_af = prev
                pcall(V.applyWalkSpeed_af)
            end)
        end

        -- Fallback: takda enforcer dikesan langsung (jarang, tapi jaga2)
        if #restoreFns == 0 then
            local char = V.LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                local prev = hum.WalkSpeed
                hum.WalkSpeed = spd
                table.insert(restoreFns, function()
                    if hum and hum.Parent then hum.WalkSpeed = prev end
                end)
            end
        end

        return function()
            for _, fn in ipairs(restoreFns) do pcall(fn) end
        end
    end

