                    statLabels[1].Text = string.format("Rebirth tier: %s", tostring(rebirthData.count))
                    statLabels[2].Text = string.format("Tower best: %s", tostring(towerBest))
                    statLabels[3].Text = string.format("Rebirth requirement floor: %s", tostring(requirementFloor))
