    local function ptSerializeList()
        local out = {}
        for _, pl in ipairs(platList) do
            table.insert(out, {
                name = pl.name,
                sPos = {x = pl.sPos.X, y = pl.sPos.Y, z = pl.sPos.Z},
                ePos = {x = pl.ePos.X, y = pl.ePos.Y, z = pl.ePos.Z},
                h = pl.h, w = pl.w,
                cfc = {pl.cf:GetComponents()}, -- simpan cframe tepat (elak drift kalau Y Offset default berubah lepas ni)
                autoSpawn = pl.autoSpawn and true or false,
            })
        end
        return out
    end

    local function ptDeserializeList(arr)
        local out = {}
        for _, e in ipairs(arr or {}) do
            if type(e) == "table" and e.sPos and e.ePos then
                local sPos = Vector3.new(e.sPos.x or 0, e.sPos.y or 0, e.sPos.z or 0)
                local ePos = Vector3.new(e.ePos.x or 0, e.ePos.y or 0, e.ePos.z or 0)
                local cf
                if type(e.cfc) == "table" and #e.cfc == 12 then
                    local ok, built = pcall(CFrame.new, table.unpack(e.cfc))
                    cf = ok and built or nil
                end
                if not cf then
                    cf = buildPlatformCF(sPos, ePos, e.h or platH, platYOffset)
                end
                table.insert(out, {
                    part = nil, -- part sebenar dicipta semula bila perlu (bukan masa load)
                    name = e.name or "Platform",
                    sPos = sPos, ePos = ePos,
                    h = e.h or platH, w = e.w or platW,
                    len = (ePos - sPos).Magnitude,
                    cf = cf,
                    autoSpawn = e.autoSpawn and true or false,
                })
            end
        end
        return out
    end

