    -- ── Public API (utk feature luar cth Win Farm panel dropdown saved
    -- route) — semua NEW wrapper, TAK ubah rbLoadRoute/rbRunRoute/
    -- rbAutoRouteActive punya logic sedia ada, cuma panggil terus.
    V.rbGetSavedRouteNames = function()
        local names = {}
        for k in pairs(rbSavedRoutes) do table.insert(names, k) end
        table.sort(names)
        return names
    end

    local rbExternalLoopActive = false
    V.rbIsExternalLoopActive = function() return rbExternalLoopActive end

    -- Loop: wait pattern1 -> jalan route sekali (guna rbRunRoute SEDIA ADA)
    -- -> wait pattern2 -> jalan lagi -> wait pattern1 -> ... ulang sampai stop.
    V.rbStartSavedRouteLoop = function(name, wait1, wait2)
        if rbExternalLoopActive then return false end
        if not rbSavedRoutes[name] then return false end
        wait1 = tonumber(wait1) or 0
        wait2 = tonumber(wait2) or 0
        rbExternalLoopActive = true
        -- FIX: FETCH FRESH setiap kali dipanggil (bukan simpan reference
        -- lama) — instance "Wins" tu boleh di-destroy & recreate semasa
        -- respawn, so reference lama jadi stale & .Value dia beku (punca
        -- bug win kena kira aborted sebelum ni).
        local function rbGetWinsVal_af()
            local ls = V.LocalPlayer:FindFirstChild("leaderstats")
            local w  = ls and ls:FindFirstChild("Wins")
            return w and w.Value
        end
        task.spawn(function()
            local usePattern1 = true
            while rbExternalLoopActive do
                local w = usePattern1 and wait1 or wait2
                local t0 = tick()
                while rbExternalLoopActive and (tick() - t0) < w do
                    task.wait(0.1)
                end
                if not rbExternalLoopActive then break end

                if not rbSavedRoutes[name] then break end -- route dah dipadam masa loop jalan
                rbLoadRoute(name)     -- fungsi sedia ada — load ke rbWaypoints/rbSegments
                rbAutoRouteActive = true
                rbUpdateAutoPill() -- sync pill dalam window Route Builder (kalau terbuka)

                -- ── Rekod "Wins" SEBELUM attempt ni mula (masih di lobby) ──
                -- Winpos = waypoint terakhir dalam saved route (winblock).
                -- rbRunRoute() akan cuba sampai situ; lepas ni kita bandingkan
                -- leaderstats Wins sebelum vs lepas utk tentukan win/aborted.
                local charBeforeRoute = V.LocalPlayer.Character
                local rbWinsBefore = rbGetWinsVal_af() or 0

                local result = rbRunRoute() -- fungsi sedia ada, blocking sampai habis/stop

                if result == "died" then
                    -- Character mati mid-route (SEBELUM sempat trigger winblock)
                    -- → game respawn automatik sendiri (bukan logic kita).
                    -- Kira sebagai satu cycle penuh: Cycle+1, Died+1.
                    rbStatCycle = rbStatCycle + 1
                    rbStatDied  = rbStatDied + 1
                    rbUpdateStatLabels()
                    print(string.format(
                        "[RB DEBUG] DIED | cycle=%d win=%d aborted=%d died=%d",
                        rbStatCycle, rbStatWin, rbStatAborted, rbStatDied))
                    -- Loop NI TAK stop — retry cycle yg sama, ulang wait
                    -- pattern yg SAMA (tak flip ke pattern lain), then cuba
                    -- route ni balik dari awal. (usePattern1 sengaja tak diubah)
                else
                    -- rbRunRoute() habis TANPA "died" = sampai waypoint
                    -- terakhir (winblock) & cuba trigger win.
                    -- FIX: flat 0.3s tak cukup kalau leaderstats "Wins" cuma
                    -- replicate LEPAS character betul2 respawn balik lobby
                    -- (yg boleh ambil >0.3s). Poll sampai 5s, break awal
                    -- terus bila Wins naik ATAU character dah berubah
                    -- (respawn), then satu fresh-read akhir lepas settle.
                    local rbWinsAfter = rbWinsBefore
                    local pollStart = tick()
                    while tick() - pollStart < 5 do
                        rbWinsAfter = rbGetWinsVal_af() or rbWinsBefore
                        if rbWinsAfter > rbWinsBefore then break end
                        if V.LocalPlayer.Character ~= charBeforeRoute then
                            task.wait(0.3) -- settle sikit lepas respawn
                            rbWinsAfter = rbGetWinsVal_af() or rbWinsAfter
                            break
                        end
                        task.wait(0.15)
                    end
                    local rbWinpoint = rbWinsAfter > rbWinsBefore

                    rbStatCycle = rbStatCycle + 1
                    if rbWinpoint then
                        rbStatWin = rbStatWin + 1
                        V.autoTpAbortStreak = 0 -- Win putuskan streak
                    else
                        rbStatAborted = rbStatAborted + 1
                        -- Streak abort BERTURUT-TURUT (bukan cumulative
                        -- rbStatAborted) — Part 4: Auto TP jugak utk
                        -- World3/Route Builder — sebelum ni check ni cuma
                        -- jalan utk World1/2 (gate V.winFarmActive yg
                        -- World3 tak pernah set true, sebab route builder
                        -- guna flow berasingan). Threshold dah boleh
                        -- diset via inputbox (V.AUTO_TP_THRESHOLD).
                        V.autoTpAbortStreak = V.autoTpAbortStreak + 1
                        if V.autoTpEnabled and V.doServerHop and V.autoTpAbortStreak >= V.AUTO_TP_THRESHOLD then
                            task.spawn(V.doServerHop)
                        end
                    end
                    rbUpdateStatLabels()
                    print(string.format(
                        "[RB DEBUG] %s | cycle=%d win=%d aborted=%d died=%d",
                        rbWinpoint and "WIN" or "ABORTED",
                        rbStatCycle, rbStatWin, rbStatAborted, rbStatDied))

                    usePattern1 = not usePattern1
                end

                if not rbExternalLoopActive then break end
            end
            rbExternalLoopActive = false
            rbAutoRouteActive    = false
            rbUpdateAutoPill()
        end)
        return true
    end

    V.rbStopSavedRouteLoop = function()
        rbExternalLoopActive = false
        rbAutoRouteActive    = false -- stop run yg tengah jalan serta-merta
        rbUpdateAutoPill()
    end

    rbRefreshList()
    rbRefreshRouteList()

end -- end ROUTE BUILDER

