local function makeDropdown(parent, name, posY)
    local wrapper = Instance.new("Frame")
    wrapper.Name = name
    wrapper.Size = UDim2.new(1, -10, 0, V.DROP_CLOSED_H)
    wrapper.Position = UDim2.new(0, 5, 0, posY)
    wrapper.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    wrapper.BorderSizePixel = 0
    wrapper.ClipsDescendants = true
    wrapper.Parent = parent
    do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,4); c.Parent = wrapper end

    local header = Instance.new("TextButton")
    header.Size = UDim2.new(1, 0, 0, V.DROP_CLOSED_H)
    header.BackgroundTransparency = 1
    header.BorderSizePixel = 0
    header.Text = name
    header.TextColor3 = Color3.fromRGB(255, 255, 255)
    header.TextSize = 10
    header.Font = Enum.Font.GothamBold
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.Parent = wrapper
    do local p = Instance.new("UIPadding"); p.PaddingLeft = UDim.new(0,8); p.Parent = header end

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(1, -8, 0, V.DROP_CLOSED_H)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▶"
    arrow.TextColor3 = Color3.fromRGB(255, 255, 255)
    arrow.TextSize = 10
    arrow.Font = Enum.Font.GothamBold
    arrow.TextXAlignment = Enum.TextXAlignment.Right
    arrow.ZIndex = 2
    arrow.Parent = wrapper

    do
        local div = Instance.new("Frame")
        div.Size = UDim2.new(1, 0, 0, 1)
        div.Position = UDim2.new(0, 0, 0, V.DROP_CLOSED_H)
        div.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        div.BackgroundTransparency = 0.8
        div.BorderSizePixel = 0
        div.Parent = wrapper
    end

    return wrapper, header, arrow
end

