    -- ── Undo ─────────────────────────────────────────────────────────
    undoBtn.MouseButton1Click:Connect(function()
        if #undoStack == 0 then return end
        local act = table.remove(undoStack)

        if act.action == "spawn" then
            -- Undo spawn: delete single wall
            local w = table.remove(wallList, act.idx)
            pcall(function() w.part:Destroy() end)
            if editingIdx == act.idx then editingIdx = nil end

        elseif act.action == "spawn_group" then
            -- Undo corridor spawn: delete semua dinding dalam group
            -- Remove dari belakang supaya indices tak shift
            local sorted = {}
            for _, i in ipairs(act.idxs) do table.insert(sorted, i) end
            table.sort(sorted, function(a,b) return a > b end)
            for _, idx in ipairs(sorted) do
                local w = table.remove(wallList, idx)
                pcall(function() w.part:Destroy() end)
                if editingIdx == idx then editingIdx = nil end
            end

        elseif act.action == "del" then
            -- Undo delete: re-insert
            local w = act.data
            -- Re-spawn part
            local folder = workspace:FindFirstChild("_WallTools")
                or (function()
                    local f = Instance.new("Folder")
                    f.Name = "_WallTools"; f.Parent = workspace; return f
