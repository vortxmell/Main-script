do -- === ROUTE BUILDER (scoped) — Step 1: waypoint capture + list ===
    -- Plan (dari perbincangan): waypoint capture -> per-segment editor
    -- (move/jump, trim/landing) -> simulate -> save named route -> load +
    -- "Auto Route" toggle jalan ikut apa yang disave. Ni step 1 sahaja:
    -- capture & manage senarai waypoint. Segment editor & save/load route
    -- akan datang lepas step ni ditest & confirmed ok.

    -- ── State ────────────────────────────────────────────────────────
    local rbWaypoints = {}   -- {name="CP1", pos=Vector3}
    local rbWinOpen    = false

    -- rbSegments[i] = config utk perjalanan CP(i) -> CP(i+1)
    -- {type="move"|"jump", startPos=Vector3, endPos=Vector3 (move sahaja),
    --  landingPos=Vector3 (jump sahaja), airTime=0.7 (jump sahaja)}
    -- startPos/endPos/landingPos default = posisi CP terlibat, tapi boleh
    -- override manual (capture posisi lain) utk elak overshoot/undershoot.
    local rbSegments  = {}
    local rbSegEditIdx = nil -- segment mana sedang expand utk edit

    local rbWin
    local rbRefreshList

    -- Pastikan rbSegments sentiasa sepadan dgn #rbWaypoints - 1, simpan
    -- config sedia ada bila boleh (dipanggil lepas add/delete/reorder)
    local function rbSyncSegments()
        local needed = math.max(#rbWaypoints - 1, 0)
        for i = 1, needed do
            if not rbSegments[i] then
    rbSegments[i] = {type = "move", airTime = 0.7}
end
        end
        for i = #rbSegments, needed + 1, -1 do
            rbSegments[i] = nil
        end
    end

    -- ── Saved routes storage — file (cross-session) + _G (same-session ──
    -- re-exec fallback), sama pattern macam Waypoints Popup sedia ada.
    local rbSavedRoutes = {} -- [name] = {waypoints={...}, segments={...}}
    local rbAutoRouteActive = false

    -- ── Tsunami phase/cycle tracker (auto-calibrate, TAK hardcode) ──────
    -- Tsunami TELEPORT balik ke start point lepas sampai hujung (bukan
    -- gerak balik gradual). Masalah asal: bila tsunami di hujung path,
    -- jarak drpd player besar (isSafe distance-only baca "selamat"),
    -- padahal dia hampir nak respawn balik dekat start point (dekat
    -- laluan player) & terus gerak penuh laju SERENTAK dgn player yg
    -- baru je mula segment (masih ramp-up, blm capai matched speed).
    -- rbWaitHazardSafe cuma check SEKALI sblm segment mula (movement
    -- lepas tu jalan blind, sengaja tak diubah), so gate ni kena confident
    -- zon "selamat" cukup lama cover ramp-up + seluruh durasi segment.
    -- Fix: track PERGERAKAN TSUNAMI SENDIRI (bukan jarak player, sbb tu
    -- tak konsisten ikut checkpoint overshoot) — detect lonjakan posisi
    -- tak masuk akal (= respawn event), auto-ukur cycle time antara
    -- respawn, block "go" masa dlm grace zone (baru respawn ATAU
    -- hampir nak respawn seterusnya).
    local rbTsunamiTrackers = {} -- [tsunamiPart] = {lastPos, lastTime, lastRespawnTime, cycleTime, emaDelta}

    local RB_TSUNAMI_START_GRACE = 0.6 -- saat lepas respawn — masih "baru", blm safe
    local RB_TSUNAMI_END_GRACE   = 1.8 -- saat sebelum respawn seterusnya (predicted) —
                                        -- lebih generous drpd versi lama sbb check
                                        -- sekali je di depan, kena cover ramp-up jugak
    local RB_TSUNAMI_SPEED_MARGIN = 1.05 -- multiplier atas speed match — bias sikit
                                          -- ke arah laju (slow = kena langgar dari
                                          -- belakang, laju sikit = paling teruk terlajak)

    local function rbUpdateTsunamiTracker(part)
        local now = tick()
        local tr = rbTsunamiTrackers[part]
        local ok, curPos = pcall(function() return part.Position end)
        if not ok then return tr end

        if not tr then
            tr = {lastPos = curPos, lastTime = now, lastRespawnTime = nil, cycleTime = nil, emaDelta = 0, speedEma = 0, speedSamples = 0}
            rbTsunamiTrackers[part] = tr
            return tr
        end

        local dt = now - tr.lastTime
        if dt > 0.01 then -- elak sample terlalu rapat (noise)
            local delta = (curPos - tr.lastPos).Magnitude
            -- lonjakan >> pergerakan biasa (adaptif, belajar speed sebenar
            -- tsunami tu secara live) = teleport/respawn detected
            if tr.emaDelta > 0 and delta > math.max(15, tr.emaDelta * 4) then
                if tr.lastRespawnTime then
                    local measuredCycle = now - tr.lastRespawnTime
                    if measuredCycle > 0.5 then -- elak false trigger awal2
                        tr.cycleTime = tr.cycleTime and ((tr.cycleTime + measuredCycle) / 2) or measuredCycle
                    end
                end
                tr.lastRespawnTime = now
                -- skip sample ni dari speed measurement (bukan pergerakan
                -- sebenar, cuma teleport — akan rosakkan purata kalau masuk)
            else
                tr.emaDelta = tr.emaDelta * 0.8 + delta * 0.2
                -- ── Speed sebenar tsunami, diukur betul2 dari pergerakan
                -- dia (bukan percaya attribute "Speed" yg mungkin tak
                -- correct/unit lain) — ground truth utk Match Speed.
                local instSpeed = delta / dt
                tr.speedEma = (tr.speedSamples < 5) and instSpeed
                    or (tr.speedEma * 0.85 + instSpeed * 0.15)
                tr.speedSamples = tr.speedSamples + 1
            end
            tr.lastPos  = curPos
            tr.lastTime = now
        end
        return tr
    end

    -- true = "quiet window" (bukan baru respawn, bukan hampir respawn seterusnya)
    local function rbIsTsunamiPhaseSafe(tr)
        if not tr or not tr.lastRespawnTime then return true end -- blm cukup data, jgn block
        local elapsed = tick() - tr.lastRespawnTime
        if elapsed < RB_TSUNAMI_START_GRACE then return false end
        if tr.cycleTime then
            local remaining = tr.cycleTime - elapsed
            if remaining < RB_TSUNAMI_END_GRACE then return false end
        end
        return true
    end

    -- ── Lava direction/phase tracker (auto-calibrate, TAK hardcode) ─────
    -- Lava naik-turun BERTERUSAN (bukan teleport macam tsunami), so
    -- "safe" tak boleh check posisi je — masalah asal: player sampai CP
    -- tepat masa lava dkt bawah (Position.Y baca "selamat"), tapi timing
    -- dia dah nak mula naik balik, so bila player mula jalan lava pun
    -- naik serentak → langgar. Fix: track ARAH pergerakan lava (naik/
    -- turun) — kalau tengah naik, terus unsafe (tak kira posisi Y pun,
    -- sebab dia sedang bergerak MENGHALA ke arah player). Kalau tengah
    -- turun, auto-ukur berapa lama biasa fasa turun tu (descentDuration)
    -- drpd turnaround sebelum ni, then block jugak kalau dah hampir
    -- sampai bawah (hampir nak reverse ke naik) — beri buffer cukup utk
    -- ramp-up + durasi segment penuh, sama pattern macam tsunami.
    local rbLavaTrackers = {} -- [lavaPart] = {lastY, lastTime, dir, lastTopTurn, lastBottomTurn, descentDuration}

    local RB_LAVA_END_GRACE = 1.5 -- saat sblm predicted bottom-turn — block "go" kalau terlalu hampir

    local function rbUpdateLavaTracker(part)
        local now = tick()
        local tr = rbLavaTrackers[part]
        local ok, curY = pcall(function() return part.Position.Y end)
        if not ok then return tr end

        if not tr then
            tr = {lastY = curY, lastTime = now, dir = 0, lastTopTurn = nil, lastBottomTurn = nil, descentDuration = nil}
            rbLavaTrackers[part] = tr
            return tr
        end

        local dt = now - tr.lastTime
        if dt > 0.01 then
            local dy = curY - tr.lastY
            if math.abs(dy) > 0.02 then -- elak noise/jitter halus dikira sbg reversal
                local newDir = (dy < 0) and -1 or 1
                if tr.dir ~= 0 and newDir ~= tr.dir then
                    if newDir == 1 then
                        -- bottom-turnaround: baru je mula naik
                        if tr.lastTopTurn then
                            local measured = now - tr.lastTopTurn
                            if measured > 0.3 then -- elak false trigger awal2
                                tr.descentDuration = tr.descentDuration and ((tr.descentDuration + measured) / 2) or measured
                            end
                        end
                        tr.lastBottomTurn = now
                    else
                        -- top-turnaround: baru je mula turun
                        tr.lastTopTurn = now
                    end
                end
                tr.dir = newDir
                tr.lastY  = curY
                tr.lastTime = now
            end
        end
        return tr
    end

    local function rbIsLavaPhaseSafe(tr)
        if not tr then return true end -- blm cukup data, jgn block
        if tr.dir == 1 then return false end -- sedang naik = unsafe, tak kira posisi
        if tr.dir == -1 and tr.lastTopTurn and tr.descentDuration then
            local elapsed = tick() - tr.lastTopTurn
            local remaining = tr.descentDuration - elapsed
            if remaining < RB_LAVA_END_GRACE then return false end -- hampir sampai bawah = hampir nak naik balik
        end
        return true
    end

    -- ── Lava EXACT model (dari decompile Pièges.LavaTower — ground truth,
    -- sama macam tsunami fix, bukan agak-agak lagi). Mode automatic (guna
    -- attribute "CycleStartTime", TAKDE manual-trigger zone), 4 fasa:
    --   RISE (RiseTime)   → Bottom.CFrame Lerp Top.CFrame, linear naik
    --   TOP dwell (TopWait) → duduk kat Top
    --   FALL (FallTime)   → Top.CFrame Lerp Bottom.CFrame, linear turun
    --   BOTTOM dwell (BottomWait) → duduk kat Bottom (SELAMAT)
    --   totalCycle = RiseTime+TopWait+FallTime+BottomWait
    --   elapsed    = (serverTime - CycleStartTime) % totalCycle
    -- Deterministic 100% — boleh kira Y masa hadapan (lookahead) tanpa
    -- perlu poll/estimate. Kalau attribute "CycleStartTime" tak wujud/0
    -- (kot2 trap ni guna mode Manual bukan Automatic — struktur beza drpd
    -- sangkaan), function ni pulang nil dan isSafe fallback ke tracker
    -- lama (safe, tak patah).
    local function rbGetLavaTrapModel_af()
        local ok, npc = pcall(function() return workspace:FindFirstChild("NPC & Piege") end)
        if not ok or not npc then return nil end
        return npc:FindFirstChild("Lava_Stage3")
    end

    -- Kira Y kat fasa tertentu (t = saat dlm cycle, 0..total). Pulang nil
    -- kalau LavaBottom/LavaTop tak jumpa (struktur tak match).
    local function rbLavaExactY(trap, t, riseTime, topWait, fallTime)
        local bottomPart = trap:FindFirstChild("LavaBottom")
        local topPart    = trap:FindFirstChild("LavaTop")
        if not (bottomPart and topPart) then return nil end
        local bottomY, topY = bottomPart.Position.Y, topPart.Position.Y
        if t < riseTime then
            return bottomY + (topY - bottomY) * (t / riseTime)
        elseif t < riseTime + topWait then
            return topY
        elseif t < riseTime + topWait + fallTime then
            local frac = (t - (riseTime + topWait)) / fallTime
            return topY + (bottomY - topY) * frac
        else
            return bottomY
        end
    end

    local function rbLavaExactState(trap)
        if not trap then return nil end
        local ok, res = pcall(function()
            local cycleStart = trap:GetAttribute("CycleStartTime")
            if not cycleStart or cycleStart == 0 then return nil end -- mode Manual, bukan Automatic
            local riseTime   = trap:GetAttribute("RiseTime")   or 5
            local topWait    = trap:GetAttribute("TopWait")    or 1
            local fallTime   = trap:GetAttribute("FallTime")   or 2
            local bottomWait = trap:GetAttribute("BottomWait") or 2
            local total = riseTime + topWait + fallTime + bottomWait
            if total <= 0 then return nil end
            return {
                cycleStart = cycleStart, total = total,
                riseTime = riseTime, topWait = topWait, fallTime = fallTime,
            }
        end)
        if not ok then return nil end
        return res
    end

    -- FIX: dulu kita require SELURUH window fixed 3.0s selamat sebelum
    -- benarkan "go" — kalau BottomWait (fasa selamat sebenar) TRAP ni
    -- lagi PENDEK drpd 3.0s, syarat tu jadi hampir mustahil dicapai
    -- (SETIAP window mesti serentak overlap sikit dgn fasa Rise seterusnya),
    -- so player wait berterusan (turun-naik berkali2) sampai maxWait 15s
    -- tamat, then TERPAKSA "go" walaupun TAK selamat (punca collision).
    -- Fix sebenar: kira BERAPA LAMA baki masa selamat dari SEKARANG
    -- (bukan syarat "seluruh window tetap"), then compare dgn keperluan
    -- minimum yg REALISTIK (jauh lebih kecil, cth 1.2s) — window besar
    -- (LOOKAHEAD_CAP) cuma had pengiraan, BUKAN syarat lulus.
    local RB_LAVA_LOOKAHEAD_CAP  = 12.0 -- saat, had ATAS pengiraan (bukan syarat)
    local RB_LAVA_LOOKAHEAD_STEP = 0.1
    local RB_LAVA_MIN_CROSS_TIME = 1.2  -- saat, baki masa selamat MINIMUM sblm dibenarkan "go"

    -- Kira baki masa (saat) dari SEKARANG sebelum Y lava akan melebihi
    -- safeY buat kali seterusnya. Pulang 0 kalau dah unsafe SEKARANG.
    -- Pulang RB_LAVA_LOOKAHEAD_CAP kalau kekal selamat sepanjang cap tu
    -- (window sangat besar, confirm selamat).
    local function rbLavaRemainingSafeTime(trap, safeY)
        local st = rbLavaExactState(trap)
        if not st then return nil end
        local ok, remaining = pcall(function()
            local now = workspace:GetServerTimeNow()
            local elapsed0 = (now - st.cycleStart) % st.total
            local y0 = rbLavaExactY(trap, elapsed0, st.riseTime, st.topWait, st.fallTime)
            if y0 == nil then return nil end
            if y0 > safeY then return 0 end -- dah unsafe SEKARANG
            local t = RB_LAVA_LOOKAHEAD_STEP
            while t <= RB_LAVA_LOOKAHEAD_CAP do
                local elapsed = (elapsed0 + t) % st.total
                local y = rbLavaExactY(trap, elapsed, st.riseTime, st.topWait, st.fallTime)
                if y == nil then return nil end
                if y > safeY then return t end
                t = t + RB_LAVA_LOOKAHEAD_STEP
            end
            return RB_LAVA_LOOKAHEAD_CAP
        end)
        if not ok then return nil end
        return remaining
    end

    local rbLavaFallbackWarned = false -- throttle print (elak spam tiap 0.1s poll)

    -- ── DEV TOOL: Scan MovingWall hazard (Stage9) — count walls + log
    -- pergerakan/kelajuan setiap satu ke file, utk analisa sebelum bina
    -- logic avoidance. TAK auto-run, TAK ada button — panggil manual dari
    -- console: rbScanMovingWalls9(20)  -- 20 = durasi scan dalam saat
    -- Hasil: console print ringkasan + file "vort_stage9_movingwall_scan.json"
    -- (raw position samples + analisa axis/range/speed/first-move-time
    -- setiap wall, kiri & kanan, tersusun ikut nombor row).
    local function rbCollectMovingWallSet(folder, side)
        local walls = {}
        if not folder then return walls end
        for _, child in ipairs(folder:GetChildren()) do
            if child.Name:match("^MovingWall%d+$") then
                local part = child:IsA("BasePart") and child
                    or child:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    table.insert(walls, {name = child.Name, side = side, part = part})
                end
            end
        end
        table.sort(walls, function(a, b)
            local an = tonumber(a.name:match("%d+")) or 0
            local bn = tonumber(b.name:match("%d+")) or 0
            return an < bn
        end)
        return walls
    end

    V.rbScanMovingWalls9 = function(duration)
        duration = tonumber(duration) or 15

        local ok, Stage9 = pcall(function()
            return workspace.Structure.Stage9
        end)
        if not ok or not Stage9 then
            warn("[RB SCAN] workspace.Structure.Stage9 tak jumpa")
            return nil
        end

        -- Kanan: folder bernama "MovingWalls". Kiri: GetChildren()[7]
        -- (ikut struktur yang Mel dah confirm secara manual dalam game).
        local rightFolder = Stage9:FindFirstChild("MovingWalls")
        local stage9Children = Stage9:GetChildren()
        local leftFolder = stage9Children[7]

        if not rightFolder then
            warn("[RB SCAN] Right folder (Stage9.MovingWalls) tak jumpa")
        end
        if not leftFolder then
            warn("[RB SCAN] Left folder (Stage9:GetChildren()[7]) tak jumpa")
        end

        local rightWalls = rbCollectMovingWallSet(rightFolder, "right")
        local leftWalls  = rbCollectMovingWallSet(leftFolder, "left")

        print(string.format(
            "[RB SCAN] Jumpa %d wall KANAN, %d wall KIRI. Mula scan %ds...",
            #rightWalls, #leftWalls, duration))

        local allWalls = {}
        for _, w in ipairs(rightWalls) do table.insert(allWalls, w) end
        for _, w in ipairs(leftWalls)  do table.insert(allWalls, w) end

        if #allWalls == 0 then
            warn("[RB SCAN] Takde wall dikesan langsung — check path/struktur.")
            return nil
        end

        -- Sampling posisi tiap wall setiap 0.05s sepanjang `duration`.
        local log = {}
        for _, w in ipairs(allWalls) do
            log[w.side .. "_" .. w.name] = {}
        end

        local t0 = tick()
        while tick() - t0 < duration do
            local t = tick() - t0
            for _, w in ipairs(allWalls) do
                local key = w.side .. "_" .. w.name
                local pos = w.part.Position
                table.insert(log[key], {
                    t = math.floor(t * 100) / 100,
                    x = math.floor(pos.X * 100) / 100,
                    y = math.floor(pos.Y * 100) / 100,
                    z = math.floor(pos.Z * 100) / 100,
                })
            end
            task.wait(0.05)
        end
        print("[RB SCAN] Scan selesai, analyzing...")

        -- Analisa tiap wall: axis pergerakan utama (range terbesar),
        -- purata speed (studs/saat, guna jumlah jarak/masa), dan masa
        -- sebelum wall tu MULA bergerak dari posisi awal (utk detect
        -- "wave"/delay antara row).
        local report = {}
        for _, w in ipairs(allWalls) do
            local key = w.side .. "_" .. w.name
            local samples = log[key]
            if #samples >= 2 then
                local minX, maxX = math.huge, -math.huge
                local minY, maxY = math.huge, -math.huge
                local minZ, maxZ = math.huge, -math.huge
                local totalDist = 0
                for i, s in ipairs(samples) do
                    minX = math.min(minX, s.x); maxX = math.max(maxX, s.x)
                    minY = math.min(minY, s.y); maxY = math.max(maxY, s.y)
                    minZ = math.min(minZ, s.z); maxZ = math.max(maxZ, s.z)
                    if i > 1 then
                        local p = samples[i - 1]
                        totalDist = totalDist + math.sqrt(
                            (s.x - p.x)^2 + (s.y - p.y)^2 + (s.z - p.z)^2)
                    end
                end
                local rangeX, rangeY, rangeZ = maxX - minX, maxY - minY, maxZ - minZ
                local axis, range = "x", rangeX
                if rangeY > range then axis, range = "y", rangeY end
                if rangeZ > range then axis, range = "z", rangeZ end

                local elapsed  = samples[#samples].t - samples[1].t
                local avgSpeed = (elapsed > 0) and (totalDist / elapsed) or 0

                local firstMoveT, first = nil, samples[1]
                for _, s in ipairs(samples) do
                    local d = math.sqrt(
                        (s.x - first.x)^2 + (s.y - first.y)^2 + (s.z - first.z)^2)
                    if d > 0.5 then firstMoveT = s.t; break end
                end

                report[key] = {
                    axis = axis,
                    rangeX = rangeX, rangeY = rangeY, rangeZ = rangeZ,
                    minX = minX, maxX = maxX, minY = minY, maxY = maxY,
                    minZ = minZ, maxZ = maxZ,
                    avgSpeed = avgSpeed, firstMoveT = firstMoveT,
                    sampleCount = #samples,
                }
                print(string.format(
                    "[RB SCAN] %-16s axis=%s range=(%.1f,%.1f,%.1f) speed=%.2f studs/s firstMove=%s samples=%d",
                    key, axis, rangeX, rangeY, rangeZ, avgSpeed,
                    firstMoveT and string.format("%.2fs", firstMoveT) or "n/a",
                    #samples))
            end
        end

        local savedToFile = false
        if writefile then
            savedToFile = pcall(function()
                writefile("vort_stage9_movingwall_scan.json", V.HttpService:JSONEncode({
                    rightCount = #rightWalls,
                    leftCount  = #leftWalls,
                    report     = report,
                    raw        = log,
                }))
            end)
        end
        print(savedToFile
            and "[RB SCAN] Log disimpan: vort_stage9_movingwall_scan.json"
            or  "[RB SCAN] writefile tak available/gagal — tengok console je utk hasil.")

        return report
    end

    -- Expose ke console/executor (chunk ni "local V", so kena expose
    -- manual supaya boleh panggil terus dari luar chunk ni).
    pcall(function()
        if getgenv then
            getgenv().rbScanMovingWalls9 = V.rbScanMovingWalls9
        else
            _G.rbScanMovingWalls9 = V.rbScanMovingWalls9
        end
    end)

    -- ── Tsunami EXACT model (dari decompile Pièges.Tsunami — ground truth,
    -- bukan agak-agak lagi). Game kira posisi tsunami PURELY dari server
    -- time + attribute, linear Lerp startCF→endCF, then TELEPORT balik ke
    -- start (sawtooth, bukan gerak balik):
    --   progress = ((serverTime - TsunamiStartTime) % TravelTime) / TravelTime
    --   pos      = TsunamiSpawn.CFrame:Lerp(TsunamiEnd.CFrame, progress)
    -- Ni deterministic 100% — boleh kira posisi/speed MASA HADAPAN (lookahead)
    -- tanpa perlu poll/estimate/tune margin macam tracker lama. Kalau
    -- model/attribute tak match (struktur beza drpd sangkaan), function ni
    -- return nil dan isSafe/getSpeed akan fallback ke tracker lama (safe).
    local function rbGetTsunamiModel_af()
        local ok, npc = pcall(function() return workspace:FindFirstChild("NPC & Piege") end)
        if not ok or not npc then return nil end
        return npc:FindFirstChild("Tsunami1")
    end
    local rbTsunamiFallbackWarned = false -- throttle print (elak spam tiap 0.1s poll)

    local function rbTsunamiExactState(model)
        if not model then return nil end
        local ok, res = pcall(function()
            local startPart  = model:FindFirstChild("TsunamiSpawn")
            local endPart    = model:FindFirstChild("TsunamiEnd")
            local startTime  = model:GetAttribute("TsunamiStartTime")
            local travelTime = model:GetAttribute("TravelTime")
            if not (startPart and endPart and startTime and travelTime and travelTime > 0) then
                return nil
            end
            local startCF, endCF = startPart.CFrame, endPart.CFrame
            local dist  = (endCF.Position - startCF.Position).Magnitude
            local speed = dist / travelTime -- constant linear, studs/saat
            return {
                startCF = startCF, endCF = endCF, startTime = startTime,
                travelTime = travelTime, dist = dist, speed = speed,
            }
        end)
        if not ok then return nil end
        return res
    end

    local RB_TSUNAMI_LOOKAHEAD      = 2.0 -- saat, anggaran konservatif masa lalu 1 segment
    local RB_TSUNAMI_LOOKAHEAD_STEP = 0.1

    -- Simulasi posisi tsunami dari SEKARANG sampai +lookahead saat, check
    -- confirm dia takkan masuk zon avoidSafeDist drpd posisi player skrg
    -- BILA-BILA masa dalam window tu — ni yg fix "player start serentak
    -- dgn tsunami baru respawn" (kita dah tahu EXACT bila reset berlaku,
    -- tak payah agak grace period) DAN "tsunami overtaking" (speed exact,
    -- bukan measured/jitter).
    local function rbTsunamiWillBeSafeAhead(model, playerX, safeDist)
        local st = rbTsunamiExactState(model)
        if not st then return nil end
        local ok, safe = pcall(function()
            local now = workspace:GetServerTimeNow()
            local t = 0
            while t <= RB_TSUNAMI_LOOKAHEAD do
                local elapsed = (now - st.startTime) + t
                if elapsed < 0 then elapsed = 0 end
                local progress = (elapsed % st.travelTime) / st.travelTime
                local pos = st.startCF:Lerp(st.endCF, progress).Position
                if math.abs(playerX - pos.X) < safeDist then
                    return false
                end
                t = t + RB_TSUNAMI_LOOKAHEAD_STEP
            end
            return true
        end)
        if not ok then return nil end
        return safe
    end

    -- ── Hazard registry (generic, boleh tambah NPC/wall/tsunami dll ──
    -- lepas ni). Setiap hazard = {label, thresholdType, getPart, isSafe}.
    -- getPart(): return part hazard tu (atau nil kalau tak jumpa).
    -- isSafe(part, wp): return true/false ikut logik masing2.
    -- thresholdType drives UI capture:
    --   "positionY" (lava) → "safe" = part.Position.Y <= wp.avoidSafeY
    --      (threshold = posisi Y absolute hazard, dicapture bila hazard
    --      tu sendiri berada kat posisi selamat)
    --   "distance" (tsunami) → "safe" = jarak player↔hazard (ikut axis
    --      tertentu, cth "x") >= wp.avoidSafeDist (threshold = jarak
    --      minimum, bukan posisi hazard)
    -- getSpeed(part) (optional) → dipakai utk mekanik "Match Speed" kat
    -- segment editor (override WalkSpeed sementara ikut speed hazard).
    local RB_HAZARDS = {
        lava_stage3 = {
            label = "Lava (Stage3)",
            thresholdType = "positionY",
            getPart = function()
                local npc = workspace:FindFirstChild("NPC & Piege")
                local lava = npc and npc:FindFirstChild("Lava_Stage3")
                return lava and lava:FindFirstChild("LavaPart")
            end,
            isSafe = function(part, wp)
                if not wp.avoidSafeY then return true end -- belum capture threshold, jgn stuck

                -- Utamakan model EXACT (server-time based, adaptive).
                local trap = rbGetLavaTrapModel_af()
                if trap then
                    local remaining = rbLavaRemainingSafeTime(trap, wp.avoidSafeY)
                    if remaining ~= nil then
                        local safe = remaining >= RB_LAVA_MIN_CROSS_TIME
                        if safe then
                            print(string.format(
                                "[RB LAVA] path=EXACT | baki masa selamat=%.1fs (perlu>=%.1fs) | SAFE, sambung jalan",
                                remaining, RB_LAVA_MIN_CROSS_TIME))
                        end
                        return safe
                    end
                end

                -- Fallback: CycleStartTime/attribute tak match sangkaan kita
                -- (mungkin mode Manual, bukan Automatic) — jangan patah, guna
                -- tracker lama.
                if not rbLavaFallbackWarned then
                    rbLavaFallbackWarned = true
                    print("[RB LAVA] path=FALLBACK (CycleStartTime/attribute tak match — guna tracker lama, exact math TAK engage)")
                end
                local tr = rbUpdateLavaTracker(part)
                if not rbIsLavaPhaseSafe(tr) then return false end -- sedang naik / hampir nak naik
                return part.Position.Y <= wp.avoidSafeY
            end,
        },
        tsunami1 = {
            label = "Tsunami (Stage3)",
            thresholdType = "distance",
            axis = "x", -- tsunami ni bergerak ikut paksi X (beza dgn Tsunami world2/stage13 yg Z)
            getPart = function()
                local npc = workspace:FindFirstChild("NPC & Piege")
                local t1 = npc and npc:FindFirstChild("Tsunami1")
                return t1 and t1:FindFirstChild("Tsunami")
            end,
            isSafe = function(part, wp)
                if not wp.avoidSafeDist then return true end -- belum capture threshold, jgn stuck
                local char = V.LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return true end

                -- Utamakan model EXACT (server-time based, ada lookahead).
                local model = rbGetTsunamiModel_af()
                if model then
                    local willBeSafe = rbTsunamiWillBeSafeAhead(model, root.Position.X, wp.avoidSafeDist)
                    if willBeSafe ~= nil then
                        if willBeSafe then
                            print("[RB TSUNAMI] path=EXACT (server-time model) | SAFE, sambung jalan")
                        end
                        return willBeSafe
                    end
                end

                -- Fallback: struktur model tak match sangkaan kita (attribute
                -- ke part tak jumpa) — jangan patah, guna tracker lama.
                if not rbTsunamiFallbackWarned then
                    rbTsunamiFallbackWarned = true
                    print("[RB TSUNAMI] path=FALLBACK (model/attribute tak match — guna tracker lama, exact math TAK engage)")
                end
                local tr = rbUpdateTsunamiTracker(part)
                if not rbIsTsunamiPhaseSafe(tr) then return false end -- baru/hampir respawn
                local dist = math.abs(root.Position.X - part.Position.X)
                return dist >= wp.avoidSafeDist
            end,
            getSpeed = function(part)
                -- Utamakan speed EXACT (dist/travelTime — constant, tiada
                -- jitter/measurement error langsung, sbb ni deterministic
                -- server-time math, bukan polling runtime).
                local model = rbGetTsunamiModel_af()
                if model then
                    local st = rbTsunamiExactState(model)
                    if st and st.speed and st.speed > 0 then
                        return st.speed * RB_TSUNAMI_SPEED_MARGIN
                    end
                end

                -- Fallback lama (measured EMA / attribute "Speed").
                local tr = rbTsunamiTrackers[part]
                local measured = (tr and tr.speedSamples >= 5 and tr.speedEma > 10) and tr.speedEma or nil
                local ok, attrSpd = pcall(function() return part:GetAttribute("Speed") end)
                attrSpd = (ok and type(attrSpd) == "number" and attrSpd > 0) and attrSpd or nil
                local base = math.max(measured or 0, attrSpd or 0)
                if base <= 0 then base = 250 end
                return base * RB_TSUNAMI_SPEED_MARGIN
            end,
        },
    }
