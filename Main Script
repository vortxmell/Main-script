        div.Size = UDim2.new(1, 0, 0, 1)
        div.Position = UDim2.new(0, 0, 0, 24)
        div.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        div.BackgroundTransparency = 0.8
        div.BorderSizePixel = 0
        div.Parent = statsWrapper
    end

    local statLabels = {}
    local statNames = {
        "Rebirth tier",
        "Tower best",
        "Rebirth requirement floor",
        "Tower floor",
        "Ready to rebirth",
        "Floor requirement level",
    }
    for i, name in ipairs(statNames) do
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -16, 0, 20)
        lbl.Position = UDim2.new(0, 8, 0, 27 + (i - 1) * 20)
