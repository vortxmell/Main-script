    -- ── Helper: build CFrame along A→B ───────────────────────────────
    local function buildWallCF(sPos, ePos, height)
        local dir  = (ePos - sPos)
        local len  = dir.Magnitude
        local mid  = (sPos + ePos) * 0.5
        -- align Z axis toward ePos
        local cf   = CFrame.new(mid, mid + dir.Unit)
        -- raise by half height so bottom touches ground, then apply Y offset
        -- (wallYOffset default -3 sebab HumanoidRootPart ~3 studs atas lantai)
        cf = cf + Vector3.new(0, height * 0.5 + wallYOffset, 0)
        return cf, len
    end

