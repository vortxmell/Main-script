        setFlySpeed(V.flySpeed)
    end)

    -- ── Core fly logic ───────────────────────────────────────────
    -- FIX v8 #1: Cleanup helper — dipanggil TERUS dalam toggle handler
    -- Ini fix bug lama: flyRS disconnect dulu sebelum RenderStepped dapat clean up
    -- Akibatnya PlatformStand kekal true → character tak boleh gerak selepas fly OFF
    local function flyCleanup()
        if V.flyRS then V.flyRS:Disconnect(); V.flyRS = nil end
        pcall(function()
            local char2 = V.LocalPlayer.Character
            if not char2 then return end
            local hrp2 = char2:FindFirstChild("HumanoidRootPart")
            if hrp2 then
                local b = hrp2:FindFirstChild("_FlyBV"); if b then b:Destroy() end
                local g = hrp2:FindFirstChild("_FlyBG"); if g then g:Destroy() end
            end
            local hum2 = char2:FindFirstChildOfClass("Humanoid")
            if hum2 and hum2.Parent then hum2.PlatformStand = false end
        end)
    end

    toggleHitbox.MouseButton1Click:Connect(function()
        V.flyEnabled = not V.flyEnabled
        updatePill(V.flyEnabled)

        if not V.flyEnabled then
            -- FIX: Cleanup terus di sini, jangan bergantung pada RenderStepped
            flyCleanup()
            return
        end

        -- Turn on
        local char = V.LocalPlayer.Character
        if not char then V.flyEnabled = false; updatePill(false); return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then V.flyEnabled = false; updatePill(false); return end

        -- Cleanup stale instances
        local old1 = hrp:FindFirstChild("_FlyBV"); if old1 then old1:Destroy() end
        local old2 = hrp:FindFirstChild("_FlyBG"); if old2 then old2:Destroy() end

        local v3zero = Vector3.new(0,0,0)
        local v3huge = Vector3.new(9e9, 9e9, 9e9)

        local bv = Instance.new("BodyVelocity")
        bv.Name     = "_FlyBV"
        bv.MaxForce = v3huge
        bv.Velocity = v3zero
        bv.Parent   = hrp

        local bg = Instance.new("BodyGyro")
        bg.Name      = "_FlyBG"
        bg.MaxTorque = v3huge
        bg.P         = 9e4
        bg.D         = 50
        bg.Parent    = hrp

        hum.PlatformStand = true

        -- Try load ControlModule (mobile joystick support)
        local ctrlOk, ctrl = pcall(function()
            return require(
                V.LocalPlayer.PlayerScripts
                    :WaitForChild("PlayerModule", 2)
                    :WaitForChild("ControlModule", 2)
            )
        end)

        if V.flyRS then V.flyRS:Disconnect() end
        V.flyRS = V.RunService.RenderStepped:Connect(function()
            -- Safety guard only (cleanup sudah dibuat dalam toggle handler)
            if not V.flyEnabled then return end

            local cam = workspace.CurrentCamera
            bg.CFrame  = cam.CoordinateFrame
            bv.Velocity = v3zero

            if ctrlOk and ctrl then
                -- Mobile (Delta): joystick via ControlModule
                -- FIX v8 #3: * 50 match IY mobilefly formula (iyflyspeed * 50)
                local dir = ctrl:GetMoveVector()
                if math.abs(dir.X) > 0.01 then
                    bv.Velocity = bv.Velocity + cam.CFrame.RightVector * (dir.X * V.flySpeed * 50)
                end
                if math.abs(dir.Z) > 0.01 then
                    bv.Velocity = bv.Velocity - cam.CFrame.LookVector * (dir.Z * V.flySpeed * 50)
                end
            else
                -- Desktop fallback: WASD + Space/Shift
                local d = v3zero
                if V.UserInputService:IsKeyDown(Enum.KeyCode.W) then d = d + cam.CFrame.LookVector end
                if V.UserInputService:IsKeyDown(Enum.KeyCode.S) then d = d - cam.CFrame.LookVector end
                if V.UserInputService:IsKeyDown(Enum.KeyCode.A) then d = d - cam.CFrame.RightVector end
                if V.UserInputService:IsKeyDown(Enum.KeyCode.D) then d = d + cam.CFrame.RightVector end
                if V.UserInputService:IsKeyDown(Enum.KeyCode.Space)     then d = d + Vector3.yAxis end
                if V.UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then d = d - Vector3.yAxis end
                if d.Magnitude > 0 then bv.Velocity = d.Unit * (V.flySpeed * 50) end
            end
        end)
    end)

    -- cfg: fly
    V.cfgRead["fly"] = function()
        return {en=V.flyEnabled, sp=V.flySpeed, mn=V.flySliderMin, mx=V.flySliderMax}
    end
    V.cfgApply["fly"] = function(t)
