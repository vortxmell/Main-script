    local function stopSpectate()
        spectEnabled = false
        -- NOTE: spectTarget intentionally NOT cleared → selection persists
        if spectViewDied  then spectViewDied:Disconnect();  spectViewDied  = nil end
        if spectViewChgd  then spectViewChgd:Disconnect();  spectViewChgd  = nil end
        if spectLeaveConn then spectLeaveConn:Disconnect(); spectLeaveConn = nil end
        pcall(function()
            workspace.CurrentCamera.CameraSubject = V.LocalPlayer.Character
        end)
        updateSpPill(false)
    end

    local function startSpectate()
        if not spectTarget or not spectTarget.Character then return end
        spectEnabled = true
        updateSpPill(true)

        pcall(function()
            workspace.CurrentCamera.CameraSubject = spectTarget.Character
        end)

        spectViewDied = spectTarget.CharacterAdded:Connect(function(newChar)
            if not spectEnabled then return end
            task.wait()
            pcall(function() workspace.CurrentCamera.CameraSubject = newChar end)
        end)

        spectViewChgd = workspace.CurrentCamera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
            if spectEnabled and spectTarget and spectTarget.Character then
                pcall(function() workspace.CurrentCamera.CameraSubject = spectTarget.Character end)
            end
        end)

        spectLeaveConn = V.Players.PlayerRemoving:Connect(function(p)
            if p == spectTarget then
                spectTarget = nil
                spPickerBtn.Text       = "Select a player"
                spPickerBtn.TextColor3 = Color3.fromRGB(100, 100, 100)
                stopSpectate()
            end
        end)
    end

    spToggleHitbox.MouseButton1Click:Connect(function()
