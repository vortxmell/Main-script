-- CheatHub LEFT recalc: Movement → Camera → Player → Misc
local function recalcCheatDropPositions()
    local tweenI   = TweenInfo.new(0.2, Enum.EasingStyle.Quart)
    local currentY = 5

    local movH = V.cheatDropState.movOpen and V.MOV_DROP_OPEN_H or V.DROP_CLOSED_H
    V.TweenService:Create(V.FlyWrapper, tweenI, {
        Position = UDim2.new(0,5,0,currentY), Size = UDim2.new(1,-10,0,movH)
    }):Play()
    currentY = currentY + movH + V.DROP_GAP

    local camH = V.cheatDropState.camOpen and V.CAM_DROP_OPEN_H or V.DROP_CLOSED_H
    V.TweenService:Create(V.CameraWrapper, tweenI, {
        Position = UDim2.new(0,5,0,currentY), Size = UDim2.new(1,-10,0,camH)
    }):Play()
    currentY = currentY + camH + V.DROP_GAP

    local playerH = V.cheatDropState.playerOpen and V.PLAYER_DROP_OPEN_H or V.DROP_CLOSED_H
    V.TweenService:Create(V.PlayerWrapper, tweenI, {
        Position = UDim2.new(0,5,0,currentY), Size = UDim2.new(1,-10,0,playerH)
    }):Play()
    currentY = currentY + playerH + V.DROP_GAP

    local miscH = V.cheatDropState.miscOpen and V.MISC_DROP_OPEN_H or V.DROP_CLOSED_H
    V.TweenService:Create(V.MiscWrapper, tweenI, {
        Position = UDim2.new(0,5,0,currentY), Size = UDim2.new(1,-10,0,miscH)
    }):Play()
    currentY = currentY + miscH + V.DROP_GAP

    local toolsH = V.cheatDropState.toolsOpen and V.TOOLS_DROP_OPEN_H or V.DROP_CLOSED_H
    V.TweenService:Create(V.ToolsWrapper, tweenI, {
        Position = UDim2.new(0,5,0,currentY), Size = UDim2.new(1,-10,0,toolsH)
    }):Play()

    updateScrollState()
end

-- CheatHub RIGHT recalc: Teleport → Anti → Server
local function recalcRightDropPositions()
    local tweenI   = TweenInfo.new(0.2, Enum.EasingStyle.Quart)
    local currentY = 5

    local tpH = V.cheatDropState.tpOpen and V.EMPTY_DROP_OPEN_H or V.DROP_CLOSED_H
    V.TweenService:Create(V.TeleportWrapper, tweenI, {
        Position = UDim2.new(0,5,0,currentY), Size = UDim2.new(1,-10,0,tpH)
    }):Play()
    currentY = currentY + tpH + V.DROP_GAP

    local antiH = V.cheatDropState.antiOpen and V.ANTI_DROP_OPEN_H or V.DROP_CLOSED_H
    V.TweenService:Create(V.AntiWrapper, tweenI, {
        Position = UDim2.new(0,5,0,currentY), Size = UDim2.new(1,-10,0,antiH)
    }):Play()
    currentY = currentY + antiH + V.DROP_GAP

    local serverH = V.cheatDropState.serverOpen and V.SERVER_DROP_OPEN_H or V.DROP_CLOSED_H
    V.TweenService:Create(V.ServerWrapper, tweenI, {
        Position = UDim2.new(0,5,0,currentY), Size = UDim2.new(1,-10,0,serverH)
    }):Play()

    updateScrollState()
end

