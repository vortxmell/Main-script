local function applySearch(query)
    local q = query:lower()

    -- CheatHub LEFT panel
    do
        local items = {
            { V.FlyWrapper,    "movement" },
            { V.CameraWrapper, "camera"   },
            { V.PlayerWrapper, "player"   },
            { V.MiscWrapper,   "misc"     },
            { V.ToolsWrapper,  "tools"    },
        }
        local curY = 5
        for _, it in ipairs(items) do
            local show = q == "" or it[2]:find(q, 1, true) ~= nil
            it[1].Visible = show
            if show then
                it[1].Position = UDim2.new(0, 5, 0, curY)
                curY = curY + it[1].Size.Y.Offset + V.DROP_GAP
            end
        end
    end

    -- CheatHub RIGHT panel
    do
        local items = {
            { V.TeleportWrapper, "teleport" },
            { V.AntiWrapper,     "anti"     },
            { V.ServerWrapper,   "server"   },
        }
        local curY = 5
        for _, it in ipairs(items) do
            local show = q == "" or it[2]:find(q, 1, true) ~= nil
            it[1].Visible = show
            if show then
                it[1].Position = UDim2.new(0, 5, 0, curY)
