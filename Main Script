V.MainFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLayout)

V.SearchBar:GetPropertyChangedSignal("Text"):Connect(function()
    if V.SearchBarContainer and V.SearchBarContainer.Visible then
        applySearch(V.SearchBar.Text)
    end
end)

setActiveTab(V.Tab1)
V.Tab1.MouseButton1Click:Connect(function()
    setActiveTab(V.Tab1)
    task.defer(function()
        updateLayout()
        updateScrollState()
    end)
end)
V.Tab2.MouseButton1Click:Connect(function()
    setActiveTab(V.Tab2)
    task.defer(function()
        updateLayout()
        applySearch(V.SearchBar.Text)
        updateScrollState()
    end)
end)
V.Tab3.MouseButton1Click:Connect(function()
    setActiveTab(V.Tab3)
    task.defer(function()
        updateLayout()
    end)
end)

setupDrag(V.TopBar)
setupDrag(V.LeftPanel)
task.defer(updateLayout)
updateScrollState()

-- ============================================================
-- CLEANUP FUNCTION
-- Stop semua active farm threads + destroy GUI.
-- Dipanggil oleh: CloseBtn, atau execute baru (via _G guard).
-- ============================================================
local function cleanupAll()
    pcall(function() if _G.VORTX_stopTreadmill then _G.VORTX_stopTreadmill() end end)
    pcall(function() if _G.VORTX_stopRebirth   then _G.VORTX_stopRebirth()   end end)
    pcall(function() if _G.VORTX_stopWinFarm   then _G.VORTX_stopWinFarm()   end end)
    pcall(function() V.ScreenGui:Destroy() end)
    _G.UITemplate_Cleanup   = nil
    _G.VORTX_stopTreadmill  = nil
    _G.VORTX_stopRebirth    = nil
    _G.VORTX_stopWinFarm    = nil
end

-- Register ke _G — execute baru akan panggil ini dulu
_G.UITemplate_Cleanup = cleanupAll
