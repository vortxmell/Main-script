                    local DataController = require(V.LocalPlayer:WaitForChild("PlayerScripts").Core.Data.DataController)
                    local RebirthBonus = require(game:GetService("ReplicatedStorage").Core.Progression.RebirthBonus)
                    local RebirthExperiment = require(game:GetService("ReplicatedStorage").Core.Progression.RebirthExperiment)
                    local TowerFloor = require(game:GetService("ReplicatedStorage").Features.Battle.tower.TowerFloor)

                    local rebirthData = DataController.rebirth()
                    local towerBest = DataController.towerBest()
                    local myArm = RebirthExperiment.armOf(V.LocalPlayer)
                    local isVariant = (myArm == RebirthExperiment.VARIANT)
                    local requirementFloor = RebirthBonus.requirementFloorFor(rebirthData.count, isVariant)
                    local readyToRebirth = (towerBest >= requirementFloor)

                    -- Floor requirement level — level chicken yg diperlukan
                    -- utk lawan DI floor requirementFloor tu sendiri (cth
                    -- requirementFloor=46 -> "Floor 46: chicken level 30").
                    local reqFloorLevel = nil
                    local okFl, flData = pcall(function() return TowerFloor.at(requirementFloor) end)
