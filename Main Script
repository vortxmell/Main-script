            sliderDown = true
            local t = math.clamp(
                (inp.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
            setFlySpeed(V.flySliderMin + (V.flySliderMax - V.flySliderMin) * t)
        end
    end)
    sliderHitbox.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch or
           inp.UserInputType == Enum.UserInputType.MouseButton1 then
            sliderDown = false
        end
    end)
    V.UserInputService.InputChanged:Connect(function(inp)
        if not sliderDown then return end
        if inp.UserInputType ~= Enum.UserInputType.Touch and
           inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end
