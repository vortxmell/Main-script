    -- ═══ Auto Upgrade Coop (dipindah ke dropdown Upgrades, y=30) ═══════
    -- Identify Part upgrade coop SECARA STABLE (bukan index — order
    -- GetChildren() boleh berubah lain server/rejoin). Setiap Part bawah
    -- CoopUI yg ada ProximityPrompt confirmed ada struktur:
    --   Part.SurfaceGui...TextLabel(name="label")  = "UPGRADE COOP" / "BUY FEEDER" / "UPGRADE FEEDER"
    --   Part.SurfaceGui...TextLabel(name="below")  = "COST $9.0K" dll (LIVE, boleh naik ikut level)
    -- Kita cari part yg label dia EXACTLY "UPGRADE COOP" setiap kali,
    -- content-based bukan position-based — reliable tak kira server.
    local function findLabelTextInGui(root, labelName)
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("TextLabel") and d.Name == labelName then
                return d
            end
        end
        return nil
    end

    local function findCoopUpgradePart()
        local CoopUI = workspace:FindFirstChild("Coops") and workspace.Coops:FindFirstChild("CoopUI")
        if not CoopUI then return nil end
        for _, child in ipairs(CoopUI:GetChildren()) do
            if child:IsA("BasePart") then
                local prompt = child:FindFirstChildOfClass("ProximityPrompt")
                local surfaceGui = child:FindFirstChildOfClass("SurfaceGui")
                if prompt and surfaceGui then
                    local lbl = findLabelTextInGui(surfaceGui, "label")
                    if lbl and lbl.Text == "UPGRADE COOP" then
                        local belowLbl = findLabelTextInGui(surfaceGui, "below")
                        return child, prompt, belowLbl
                    end
                end
            end
        end
        return nil
    end

    -- Parse "COST $9.0K" / "COST $612" / "$1.2M" / "$3B" dll ke nombor.
    local function parseCostText(text)
        if not text then return nil end
        local numStr, suffix = string.match(text, "%$?([%d%.]+)%s*([KMB]?)")
        if not numStr then return nil end
        local n = tonumber(numStr)
        if not n then return nil end
        if suffix == "K" then n = n * 1e3
        elseif suffix == "M" then n = n * 1e6
        elseif suffix == "B" then n = n * 1e9 end
        return n
    end

