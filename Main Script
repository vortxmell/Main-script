    -- ── Execute route sekali laluan (move/jump ikut segment config) ───
    local function rbRunRoute()
        if #rbWaypoints < 2 then
            rbAutoRouteActive = false
            rbUpdateAutoPill()
            return
        end
        local startChar = V.LocalPlayer.Character
        pcall(function()
            local char = V.LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then root.CFrame = CFrame.new(rbWaypoints[1].pos) end
        end)
        task.wait(0.3)

        local died = false

        -- Reset AdvNoclip ke OFF di permulaan setiap cycle (baseline bersih;
        -- CP1 biasanya tak perlukan advnoclip, kalau ada pun akan di-set
        -- balik ikut flag CP tu sendiri di bawah)
        if V.advNcSetEnabled then pcall(V.advNcSetEnabled, false) end

        for i = 1, #rbWaypoints - 1 do
            if not rbAutoRouteActive then break end
            -- Character berubah (mati → respawn lobby dll) — STOP terus,
            -- jangan cuba "sambung checkpoint". Biar Roblox handle respawn
            -- biasa. Punca player "terbang jauh" sebelum ni: segment lepas
            -- mati tetap jalan, tapi guna character BARU (posisi lobby)
            -- dgn velocity/moveTo yg dikira utk posisi checkpoint LAMA.
            if V.LocalPlayer.Character ~= startChar then
                died = true
                break
            end
            local seg = rbSegments[i] or {type = "move"}
            local wp, nextWp = rbWaypoints[i], rbWaypoints[i + 1]
            local skipTeleport = (i > 1) -- lepas segment pertama, root dah betul-betul
                                          -- kat posisi landing terakhir — jangan teleport/wait
                                          -- lagi, terus sambung jump/move (elak "stop-stop")

            -- AdvNoclip: ikut flag CP `wp` (checkpoint YANG DITINGGALKAN utk
            -- segment ni). "Melekat" sepanjang segment ni sampai CP lepas ni
            -- ubah dia balik — bukan restore lepas satu segment je (beza dgn
            -- Match Speed) sebab tu cara contoh CP4→CP5 on, CP5→CP6 auto off
            -- (sebab CP5 punya flag = off) berfungsi.
            if V.advNcSetEnabled then pcall(V.advNcSetEnabled, wp.advNoclip == true) end

            -- Sampai kat CP ni dulu (wp) — kalau CP ni ada hazard (cth lava)
            -- kena tunggu selamat dulu sebelum sambung ke CP seterusnya.
            if wp.avoid then rbWaitHazardSafe(wp) end
            if not rbAutoRouteActive then break end
            if V.LocalPlayer.Character ~= startChar then died = true; break end

            local ok
            if seg.type == "jump" then
                ok = rbTestJump(wp.pos, seg.landingPos or nextWp.pos, seg.airTime, skipTeleport)
            else
                -- Match Speed: override WalkSpeed sementara utk segment ni
                -- SAHAJA (cth ikut speed tsunami supaya boleh "jalan sama
                -- cepat" dgn dia tanpa kena lari/kena langgar). rbApplySpeedMatch
                -- lapis semua enforcer aktif (Movement WalkSpeed toggle /
                -- Win Farm speed watcher) supaya override betul2 "melekat"
                -- sepanjang segment, then restore() balik lepas selesai —
                -- CP lepas ni fallback ke speed default macam biasa.
                local restore = rbApplySpeedMatch(seg)
                if wp.avoid then
                    -- Bungkus dgn monitor (validation tool) — track jarak
                    -- terdekat SEBENAR sepanjang segment ni, print lepas
                    -- habis. Tak ubah movement/keputusan ok langsung.
                    ok = rbMonitorHazardDuringSegment(wp.avoid, function()
                        return rbTestMove(seg.startPos or wp.pos, seg.endPos or nextWp.pos, skipTeleport)
                    end)
                else
                    ok = rbTestMove(seg.startPos or wp.pos, seg.endPos or nextWp.pos, skipTeleport)
                end
                restore()
            end
            if ok == false then
                died = true
                break
            end
        end

        rbAutoRouteActive = false
        rbUpdateAutoPill()

        -- AdvNoclip fallback OFF: cover 2 kes — (1) mati tengah jalan
        -- (item 1 punya keperluan explicit), (2) loop habis/stop dgn
        -- CP terakhir yg dilalui tu kebetulan advNoclip=ON (elak stuck ON).
        if V.advNcSetEnabled then pcall(V.advNcSetEnabled, false) end

        if died then
            pcall(function()
                rbStatusLbl.Text = "Route dihentikan: character mati/respawn."
                rbStatusLbl.TextColor3 = Color3.fromRGB(255,150,80)
                task.delay(3, function()
                    if rbStatusLbl then rbStatusLbl.Text = "" end
                end)
            end)
            return "died"
        end
    end

