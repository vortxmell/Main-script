    V.autoUpgradeFeederEnabled_af = false
    local autoUpgradeFeederLoopRunning = false

    local function autoUpgradeFeederRunLoop()
        if autoUpgradeFeederLoopRunning then return end
        autoUpgradeFeederLoopRunning = true
        task.spawn(function()
            while V.autoUpgradeFeederEnabled_af do
                local ok, err = pcall(function()
                    -- Phase A: BUY FEEDER dulu — feeder yg belum dibeli.
                    -- Ni bukan round-robin (beda dari upgrade), sebab "buy"
                    -- cuma unlock SATU slot baru bila mampu, terus beli kalau
                    -- duit cukup, tak perlu gilir macam upgrade.
                    local buyList = findAllFeederBuyParts()
                    if #buyList > 0 then
                        local ls = V.LocalPlayer:FindFirstChild("leaderstats")
                        local moneyStat = ls and ls:FindFirstChild("Money")
                        local rawMoney = moneyStat and moneyStat.Value
                        local buyMoney
                        if type(rawMoney) == "number" then
                            buyMoney = rawMoney
                        elseif rawMoney ~= nil then
                            buyMoney = parseCostText(tostring(rawMoney))
                        end
                        for _, buyEntry in ipairs(buyList) do
                            local buyCost = parseCostText(buyEntry.belowLbl and buyEntry.belowLbl.Text)
                            if buyCost and buyMoney and buyMoney >= buyCost then
                                fireproximityprompt(buyEntry.prompt)
                                -- tolak anggaran baki supaya kalau ada >1 Part
                                -- "BUY FEEDER" serentak, tak overspend dalam
                                -- cycle yg sama (leaderstats belum update lagi).
                                buyMoney = buyMoney - buyCost
                            end
                        end
                    end

                    -- Phase B: UPGRADE FEEDER — LEVEL EQUALIZE (bukan round-robin
                    -- ikut posisi lagi). Cari level PALING RENDAH antara semua
                    -- feeder yg belum maxed, upgrade HANYA feeder(s) pada level
                    -- tu. Bila dah sama level dgn tier seterusnya, tick
                    -- seterusnya akan re-scan & candidate set naik sekali.
                    -- Cth: [5,5,5,4,4,1] -> upgrade feeder lvl1 je sampai jadi
                    -- 4, lepas tu [5,5,5,4,4,4] -> upgrade ketiga2 lvl4 sekali
                    -- sampai jadi 5, lepas tu semua sama & naik bersama.
                    local list = findAllFeederUpgradeParts()
                    if #list == 0 then
                        return
                    end

                    local minLevel = nil
                    for _, e in ipairs(list) do
                        if e.level then
                            if not minLevel or e.level < minLevel then
                                minLevel = e.level
                            end
                        end
                    end
                    if not minLevel then
                        return
                    end

                    local ls = V.LocalPlayer:FindFirstChild("leaderstats")
                    local moneyStat = ls and ls:FindFirstChild("Money")
                    local rawMoney = moneyStat and moneyStat.Value
                    local money
                    if type(rawMoney) == "number" then
                        money = rawMoney
                    elseif rawMoney ~= nil then
                        money = parseCostText(tostring(rawMoney))
                    end

                    for _, entry in ipairs(list) do
                        if entry.level == minLevel then
                            local cost = parseCostText(entry.belowLbl and entry.belowLbl.Text)
                            if cost and money and money >= cost then
                                fireproximityprompt(entry.prompt)
                                -- tolak anggaran baki utk elak overspend kalau
                                -- ada >1 feeder pada min level yg sama dlm cycle ni.
                                money = money - cost
                            end
                        end
                    end
                end)
                task.wait(0)
            end
            autoUpgradeFeederLoopRunning = false
        end)
    end

