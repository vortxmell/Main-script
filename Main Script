function updateScrollState()
    local visH = V.MainFrame.AbsoluteSize.Y - V.TOP_H - (
        V.SearchBarContainer and V.SearchBarContainer.Visible and V.SEARCH_H or 0
    )

    if V.Tab2Content.Visible then
        -- CheatHub LEFT panel
        local movH    = V.cheatDropState.movOpen    and V.MOV_DROP_OPEN_H   or V.DROP_CLOSED_H
        local camH    = V.cheatDropState.camOpen    and V.CAM_DROP_OPEN_H   or V.DROP_CLOSED_H
        local playerH = V.cheatDropState.playerOpen and V.PLAYER_DROP_OPEN_H or V.DROP_CLOSED_H
        local miscH   = V.cheatDropState.miscOpen   and V.MISC_DROP_OPEN_H  or V.DROP_CLOSED_H
        local toolsH  = V.cheatDropState.toolsOpen  and V.TOOLS_DROP_OPEN_H or V.DROP_CLOSED_H
        local totalH = 5 + movH + V.DROP_GAP + camH + V.DROP_GAP + playerH + V.DROP_GAP + miscH + V.DROP_GAP + toolsH + 5
        V.ContentPanelLeft.CanvasSize = UDim2.new(0, 0, 0, totalH)
        V.ContentPanelLeft.ScrollBarThickness = (totalH > visH) and 4 or 0

        -- CheatHub RIGHT panel
        local tpH     = V.cheatDropState.tpOpen     and V.EMPTY_DROP_OPEN_H  or V.DROP_CLOSED_H
        local antiH   = V.cheatDropState.antiOpen   and V.ANTI_DROP_OPEN_H   or V.DROP_CLOSED_H
        local serverH = V.cheatDropState.serverOpen and V.SERVER_DROP_OPEN_H  or V.DROP_CLOSED_H
        local totalR = 5 + tpH + V.DROP_GAP + antiH + V.DROP_GAP + serverH + 5
        V.Tab2RightContent.CanvasSize = UDim2.new(0, 0, 0, totalR)
        V.Tab2RightContent.ScrollBarThickness = (totalR > visH) and 4 or 0
    elseif V.Tab3AFContent and V.Tab3AFContent.Visible then
        -- Auto Farm: Farming + Upgrades wrapper (Win Farm/Shop dah dibuang, game baru)
        local afH = V.afDropOpen and V.AF_DROP_OPEN_H or V.AF_DROP_CLOSED_H
        local upH = V.upDropOpen and V.UP_DROP_OPEN_H or V.UP_DROP_CLOSED_H
        local totalH = 5 + afH + V.DROP_GAP + upH + 5
        V.ContentPanelLeft.CanvasSize = UDim2.new(0, 0, 0, totalH)
        V.ContentPanelLeft.ScrollBarThickness = (totalH > visH) and 4 or 0
    end
end

-- ========================
