    local function buildPlatformCF(sPos, ePos, thickness, yOffset)
        local dir  = (ePos - sPos)
        local len  = dir.Magnitude
        local mid  = (sPos + ePos) * 0.5
        -- align lookVector ke arah ePos supaya length axis (Z) ikut A→B,
        -- lebar (X) automatik jadi lateral, thickness (Y) automatik jadi tegak
        local cf = CFrame.new(mid, mid + dir.Unit)
        cf = cf + Vector3.new(0, yOffset, 0)
        return cf, len
    end

