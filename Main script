        return {en=akEnabled}
    end
    V.cfgApply["ak"] = function(t)
        local wantOn = (t.en == true)
        if wantOn and not akEnabled then
            akEnabled = true
            updateAkPill(true)
            if not akHooked then
                pcall(function()
                    if not hookmetamethod then return end
                    local lp3 = V.LocalPlayer
                    if hookfunction then hookfunction(lp3.Kick, function() end) end
                    local oldI3; oldI3 = hookmetamethod(game, "__index", function(s, m)
                        if s == lp3 and m:lower() == "kick" then
                            return error("Expected ':' not '.' calling member function Kick", 2)
                        end
                        return oldI3(s, m)
                    end)
                    local oldN3; oldN3 = hookmetamethod(game, "__namecall", function(s, ...)
                        if s == lp3 and getnamecallmethod():lower() == "kick" then return end
                        return oldN3(s, ...)
                    end)
                    akHooked = true
                end)
            end
        elseif (not wantOn) and akEnabled then
            -- hook stays active; only update visual
            akEnabled = false
            updateAkPill(false)
        end
    end

    -- cfg: anti-gameplay-paused
    V.cfgRead["agp"] = function()
        return {en=agpEnabled}
    end
    V.cfgApply["agp"] = function(t)
        local wantOn = (t.en == true)
        if agpEnabled ~= wantOn then
            agpEnabled = wantOn
            updateAgpPill(agpEnabled)
            if agpEnabled then
                pcall(function() if agpConn then agpConn:Disconnect() end end)
                pcall(function()
                    local rg = game:GetService("CoreGui"):FindFirstChild("RobloxGui")
                    if not rg then return end
                    local ex = rg:FindFirstChild("CoreScripts/NetworkPause")
                    if ex then ex:Destroy() end
                    agpConn = rg.ChildAdded:Connect(function(obj)
                        if agpEnabled and obj.Name == "CoreScripts/NetworkPause" then
                            obj:Destroy()
                        end
                    end)
                end)
            else
                pcall(function()
                    if agpConn then agpConn:Disconnect(); agpConn = nil end
                end)
            end
        end
    end

end -- end ANTI/PROTECTION

